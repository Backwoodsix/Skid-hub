-- Gets the player onto the spawned bike with the sequence that is known to work: drop onto a plate
-- under the map, wait 1.5s, glide in 1.7-stud steps every 0.1s to the point under the seat's left side,
-- rise straight beside the DriveSeat, remove the plate, then fire the seat's prompt every frame
-- until the humanoid is seated.
local BIKE_PLATE_Y = -14.2
local BIKE_ROOT_Y = BIKE_PLATE_Y + 8
local BIKE_MOVE_STEP = 1.7

local function bikeSeatSide(seat)
    return seat.Position + (-seat.CFrame.RightVector * 2)
end

local function approachUnderBike(bike)
    local _, humanoid, root = getCharacterParts()
    local seat = getBikeSeat(bike)
    if not (humanoid and root and seat) or not farmAlive() then return false end

    local plate = Instance.new("Part")
    plate.Name = "SkidBikeApproachPlate"
    plate.Size = Vector3.new(25, 12, 25)
    plate.Anchored = true
    plate.CanCollide = true
    plate.CanTouch = false
    plate.Transparency = 1
    plate.Position = Vector3.new(root.Position.X, BIKE_PLATE_Y, root.Position.Z)
    plate.Parent = Workspace
    local function bail()
        if plate.Parent then plate:Destroy() end
        return false
    end

    local goal = bikeSeatSide(seat)
    local target = Vector3.new(goal.X, BIKE_ROOT_Y, goal.Z)
    root.CFrame = CFrame.new(root.Position.X, BIKE_ROOT_Y, root.Position.Z)
    task.wait(1.5)
    if not farmAlive() then return bail() end

    local distance = math.huge
    repeat
        local _, hum, r = getCharacterParts()
        if not (hum and r) or not farmAlive() then return bail() end
        local current = r.Position
        distance = (Vector2.new(target.X, target.Z) - Vector2.new(current.X, current.Z)).Magnitude
        if distance <= BIKE_MOVE_STEP then break end
        local dir = (target - current).Unit
        local nextPos = current + dir * BIKE_MOVE_STEP
        r.CFrame = CFrame.new(nextPos, nextPos + dir)
        plate.Position = Vector3.new(nextPos.X, BIKE_PLATE_Y, nextPos.Z)
        task.wait(0.1)
    until false

    if not farmAlive() then return bail() end
    local _, _, r2 = getCharacterParts()
    if not r2 then return bail() end
    r2.CFrame = CFrame.new(target)
    plate.Position = Vector3.new(target.X, BIKE_PLATE_Y, target.Z)

    -- re-read the live bike and seat right before rising
    if not (bike and bike.Parent) then return bail() end
    seat = getBikeSeat(bike)
    if not seat then return bail() end
    local _, _, r3 = getCharacterParts()
    if not r3 then return bail() end
    r3.CFrame = CFrame.new(bikeSeatSide(seat) + Vector3.new(0, 2.5, 0))
    task.wait()
    if plate.Parent then plate:Destroy() end
    task.wait(0.1)
    return true
end

