        -- Used when we want to move WITHOUT the underground tween dip. The
        -- underground dip is only needed for longer travels where visual
        -- anti-cheat might flag a direct teleport. Within selling distance
        -- (all around Lamont) we just snap.
        local function snapTo(pos)
            local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if root then
                root.CFrame = CFrame.new(pos)
            end
        end

        -- to just snap, instead of doing the full underground tween?
        local function nearLamont(radius)
            radius = radius or 25
            local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if not root then return false end
            return (root.Position - LAMONT_POS).Magnitude <= radius
        end

        -- Problem: firePrompt was spammed without verifying the bag was
        -- actually in the character's HANDS (not just backpack). When the
        -- bag wasn't equipped, firing Lamont's prompt opened the shop UI
        -- instead of selling. Also sellAll + sellBag both called equipTool,
        -- creating a race.
        -- Fix: isBagEquipped check, forceful ensureEquipped, close stray
        -- shop UI if it opens, single fire per cycle with verification.

        local function isBagEquipped(name)
            return lp.Character and lp.Character:FindFirstChild(name) ~= nil
        end

        -- Previously this function pressed Escape as a "failsafe" to dismiss
        -- modal dialogs, but in Roblox pressing Escape opens the main pause
        -- menu (People / Settings / Leave / Respawn / Resume). That froze
        -- the farm every few seconds whenever sellBag called closeLamontUI.
        -- Now we only disable matching ScreenGuis, and if the Roblox pause
        -- menu did somehow get opened by another path we close it via
        -- GuiService:SetMenuIsOpen(false), which is the API Roblox exposes
        -- for programmatically dismissing the pause menu.
        local function closeLamontUI()
            local gui = lp:FindFirstChild("PlayerGui")
            if gui then
                for _, g in ipairs(gui:GetChildren()) do
                    if g:IsA("ScreenGui") then
                        local n = string.lower(g.Name or "")
                        if n:find("shop") or n:find("lamont") or n:find("sell")
                           or n:find("vendor") or n:find("bellshop")
                           or n:find("bell_shop") or n:find("npcshop") then
                            pcall(function() g.Enabled = false end)
                        end
                    end
                end
            end
            -- If the Roblox pause menu is open for any reason, close it.
            -- Never uses the Escape key, which would re-toggle it.
            pcall(function()
                local gs = game:GetService("GuiService")
                if gs and gs.MenuIsOpen then
                    gs:SetMenuIsOpen(false)
                end
            end)
        end

        local function ensureEquipped(name, maxTries)
            maxTries = maxTries or 8
            for _ = 1, maxTries do
                if isBagEquipped(name) then return true end
                if stableCount(name) < 1 then return false end
                local tool = getTool(name)
                if tool then
                    pcall(function()
                        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                        if hum then
                            -- unequip anything else first so the character
                            -- has a clean slot and actually holds the new tool
                            hum:UnequipTools()
                            task.wait(0.08)
                            hum:EquipTool(tool)
                        end
                    end)
                end
                task.wait(0.2)
            end
            return isBagEquipped(name)
        end

        local function sellBag(name)
            local before = stableCount(name)
            if before < 1 then return false end

            -- STEP 1: equip and VERIFY before doing anything else
            if not ensureEquipped(name, 8) then
                return false
            end
            task.wait(0.2) -- settle: let character render the equipped tool

            -- STEP 2: close any stray UI that might have been opened earlier
            closeLamontUI()

            local deadline   = tick() + 22
            local startCount = stableCount(name)
            local lastFireAt = 0
            local fireGap    = 0.6   -- minimum gap between fires (anti-spam)

            while not mfStopped() and farm.Enabled and farm.IsFarming and tick() < deadline do
                -- Re-verify the bag is still in hand before every single fire.
                -- If something unequipped it (shop UI click, stray input), we
                -- re-equip BEFORE firing, which is the whole point of this fix.
                if not isBagEquipped(name) then
                    closeLamontUI()
                    if stableCount(name) < 1 then
                        return stableCount(name) < before
                    end
                    if not ensureEquipped(name, 4) then
                        return stableCount(name) < before
                    end
                    task.wait(0.2)
                end

                local pp = findLamont()
                if not pp then
                    snapToLamont()
                    task.wait(0.2)
                    openLamont()
                    pp = findLamont()
                end

                -- Only fire if enough time has passed since the last fire.
                -- Firing in a tight loop is what triggered the shop UI open
                -- in v27.4 because each click was racing the equip cycle.
                if pp and tick() - lastFireAt >= fireGap then
                    -- Re-check one more time right before the actual fire
                    if not isBagEquipped(name) then
                        task.wait(0.1)
                    else
                        firePrompt(pp)
                        lastFireAt = tick()
                        task.wait(0.5)

                        local nowCount = stableCount(name)
                        if nowCount < startCount then
                            return true
                        end
                    end
                else
                    task.wait(0.1)
                end
            end
            task.wait(0.2)
            return stableCount(name) < before
        end

        local function tweenToLamont()
            if getgenv().ForceTweenTeleport then
                getgenv().ForceTweenTeleport(LAMONT_POS)
            else
                getgenv().NullTeleport(LAMONT_POS)
            end
            task.wait(0.45)
            openLamont()
        end

        -- Before: when a bag partially sold, it called tweenToLamont()
        -- which does the underground DIP (Y=-2.4 → tween → back up).
        -- That's the "bajón" the user was seeing between bag types.
        -- Now: we only do the underground tween ONCE at the start of
        -- sellAll to get to Lamont. Between bags we just snapTo the
        -- Lamont position — character stays at ground level the whole
        -- time, no dip, no visible fall.
        local function sellAll()
            -- Only tween underground if we're actually far from Lamont.
            -- If we're already close (e.g. just finished a sell retry),
            -- just snap — no dip.
            if nearLamont(40) then
                snapTo(LAMONT_POS)
                task.wait(0.15)
            else
                tweenToLamont()
                task.wait(0.25)
            end
            closeLamontUI()

            local bagOrder = {
                "Large Marshmallow Bag",
                "Medium Marshmallow Bag",
                "Small Marshmallow Bag",
            }

            for _, bagName in ipairs(bagOrder) do
                local stuckGuard = 0
                while not mfStopped() and farm.Enabled and farm.IsFarming and hasBag(bagName) do
                    local before = stableCount(bagName)
                    local ok = sellBag(bagName)
                    local after = stableCount(bagName)

                    if ok then
                        getgenv().FarmStatus.MarshmallowSold =
                            (getgenv().FarmStatus.MarshmallowSold or 0) + (before - after)
                        stuckGuard = 0
                    end

                    if after > 0 then
                        stuckGuard = stuckGuard + 1
                        if stuckGuard >= 3 then
                            break
                        end
                        -- UPDATED v27.11: NO tweenToLamont here.
                        -- Just close any stray UI and snap position back
                        -- to Lamont's spot — character never leaves ground.
                        closeLamontUI()
                        snapTo(LAMONT_POS)
                        task.wait(0.15)
                    end
                end
            end

            -- Final sweep: same rule — snap, don't tween.
            local anyLeft = false
            for _, bagName in ipairs(bagOrder) do
                if hasBag(bagName) then anyLeft = true; break end
            end
            if anyLeft and not mfStopped() and farm.Enabled and farm.IsFarming then
                closeLamontUI()
                snapTo(LAMONT_POS)
                task.wait(0.2)
                openLamont()
                for _, bagName in ipairs(bagOrder) do
                    local guard = 0
                    while not mfStopped() and farm.Enabled and farm.IsFarming and hasBag(bagName) and guard < 3 do
                        sellBag(bagName)
                        guard = guard + 1
                        task.wait(0.2)
                    end
                end
            end

            closeLamontUI()
        end

        local function getCookingPot(aptModel)
            if not aptModel then return nil end
            return aptModel:FindFirstChild("Cooking Pot", true)
        end

        local function getCookingPrompt(aptModel)
            local pot = getCookingPot(aptModel)
            if not pot then return nil end
            local att = pot:FindFirstChild("Attachment") or pot:FindFirstChildWhichIsA("Attachment", true)
            if att then
                local pp = att:FindFirstChildWhichIsA("ProximityPrompt", true)
                if pp then return pp end
            end
            local pp = pot:FindFirstChildWhichIsA("ProximityPrompt", true)
            if pp then return pp end
            return nil
        end

        local function getCookingPotPos(aptModel)
            local pot = getCookingPot(aptModel)
            if not pot then return nil end
            local pos
            pcall(function()
                if pot:IsA("Model") then
                    pos = pot:GetPivot().Position
                else
                    pos = pot.CFrame.Position
                end
            end)
            if not pos then return nil end
            return pos + Vector3.new(0, -6, 0)
        end

        -- User reported the throttled version was breaking cooking.
        local function spamCookingPrompt(pp, times)
            if not pp then return end
            times = times or 3
            for _ = 1, times do
                firePrompt(pp)
                task.wait(0.05)
            end
        end

        local function doWaterStep(aptPos, skipFirstUp)
            if mfStopped() then return false end

            local aptFolder = getAptFolder()
            local myAptModel
            if aptFolder then
                for _, m in pairs(aptFolder:GetChildren()) do
                    if playerOwnsApt(m) then myAptModel = m; break end
                end
            end

            local potLevel = getCookingPotPos(myAptModel) or aptPos
            -- v27.43: "just below the pot" instead of all the way underground.
            -- User wanted to stay close to the pot between items instead of
            -- going down to -8.5. Now we only go down 3 studs from pot level.
            local underground = Vector3.new(potLevel.X, potLevel.Y - 3, potLevel.Z)

            local function atPotLevel()
                local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                if not root then return false end
                local p = root.Position
                local xz = (Vector3.new(p.X, 0, p.Z) - Vector3.new(potLevel.X, 0, potLevel.Z)).Magnitude
                local dy = math.abs(p.Y - potLevel.Y)
                return xz <= 10 and dy <= 5
            end

            local function goUp(force)
                if not force and atPotLevel() then return end
                getgenv().NullTeleport(potLevel)
                task.wait(0.25)
            end

            local function goDown()
                getgenv().NullTeleport(underground)
                task.wait(0.2)
            end

            local function interactAtPot(itemName)
                if stableCount(itemName) < 1 then return false end
                local before = stableCount(itemName)
                if not equipTool(itemName) then
                    for _ = 1, 3 do
                        if equipTool(itemName) then break end
                        task.wait(0.08)
                    end
                end
                if stableCount(itemName) < 1 then return false end
                local pp = getCookingPrompt(myAptModel)
                if not pp then return false end
                spamCookingPrompt(pp, 3)
                if stableCount(itemName) >= before then
                    spamCookingPrompt(pp, 3)
                end
                return true
            end

            if mfStopped() then return false end
            if not skipFirstUp then
                goUp(true)
            elseif not atPotLevel() then
                goUp(true)
            end

            -- v27.44: NO goDown anywhere during cooking.
            -- Stay AT the pot through the whole cook cycle. The character
            -- just waits at pot level during the 21s and 46s cook timers.
            if mfStopped() then return false end
            interactAtPot("Water")
            task.wait(1.0)

            if not safeWait(21) then return false end

            if mfStopped() then return false end
            interactAtPot("Sugar Block Bag")
            task.wait(1.5)

            if mfStopped() then return false end
            interactAtPot("Gelatin")
            task.wait(1.0)

            if not safeWait(46) then return false end

            if mfStopped() then return false end
            interactAtPot("Empty Bag")
            task.wait(0.6)

            return hasMarshmallow()
        end

        -- actually completed before returning. Previously it fired buyItem
        -- for each ID in order but didn't recheck the totals at the end —
        -- if a buffer fire silently failed (rate limit, dropped packet),
        -- we'd end up cooking with missing items. Now we check at the end
        -- and retry any item that came up short.
        local function doShop(skipTp)
            if mfStopped() then return false end
            if not skipTp then
                if getgenv().InstantRespawnTP then
                    getgenv().InstantRespawnTP(LAMONT_POS)
                else
                    getgenv().NullTeleport(LAMONT_POS)
                end
                task.wait(0.4)
            end
            enableAptNoclip()
            openLamont()
            if mfStopped() then return false end
            local qty = farm.ShopClicks or 1

            -- First pass: buy each item in order
            for _, id in ipairs(BUY_IDS) do
                if mfStopped() then return false end
                buyItem(id, qty)
            end

            -- Verification pass: confirm each item is at target count.
            -- Up to 2 retries per item in case a buffer fire was dropped.
            for _, id in ipairs(BUY_IDS) do
                if mfStopped() then return false end
                local name = ITEM_IDS[id]
                local retries = 0
                while retries < 2 and stableCount(name) < qty do
                    buyItem(id, qty)
                    retries = retries + 1
                end
            end

            task.wait(0.25)
            return true
        end

        -- User wants the tween underground every cycle (buy → tp underground
        -- → cook → sell → repeat) instead of the respawn teleport, because
        -- the respawn is more detectable and sometimes drops equipped tools.
        local function tweenToHouse(aptPos)
            if getgenv().ForceTweenTeleport then
                getgenv().ForceTweenTeleport(aptPos)
                task.wait(0.4)
            elseif getgenv().NullTeleport then
                getgenv().NullTeleport(aptPos)
                task.wait(0.4)
            end
        end

        local function farmCycle(aptPos)
            farm.CycleActive = true
            stopFlag = false
            local needShopTrip = true

            while farm.Enabled and not stopFlag do
                doShop(not needShopTrip)
                needShopTrip = true
                if not farm.Enabled or stopFlag then break end

                tweenToHouse(aptPos)
                if not farm.Enabled or stopFlag then break end

                local success = 0
                local maxCooks = farm.ShopClicks or 1
                local failures = 0
                local firstCook = true
                while farm.Enabled and not stopFlag and success < maxCooks do
                    local ok = doWaterStep(aptPos, firstCook)
                    firstCook = false
                    if ok then
                        success = success + 1
                        failures = 0
                    else
                        failures = failures + 1
                        local noItems = stableCount("Water") < 1
                            and stableCount("Sugar Block Bag") < 1
                            and stableCount("Gelatin") < 1
                            and stableCount("Empty Bag") < 1
                        if failures >= 3 or noItems then break end
                        task.wait(1)
                    end
                    task.wait(0.4)
                end

                if not farm.Enabled or stopFlag then break end

                sellAll()
                if not farm.Enabled or stopFlag then break end

                doShop(true)
                needShopTrip = false
                if not farm.Enabled or stopFlag then break end
                task.wait(0.25)
            end

            farm.CycleActive = false
            farm.IsFarming   = false
            if getgenv().SetNoclip then getgenv().SetNoclip(false) end
        end

        local function startFarm()
            local mf = getgenv().MarshmallowFarm
            if mf.IsFarming then return end
            mf.IsFarming = true
            mf.Enabled   = true
            stopFlag     = false

            if getgenv()._MF_SpawnBP then getgenv()._MF_SpawnBP() end

            task.spawn(function()
                -- UPDATED v27.33: no auto-rent. User buys apt manually.
                -- If no apt is owned when the farm is toggled on, just
                -- stop with a quiet log — don't try to buy anything.
                local aptPos = getAptTpPos()
                if not aptPos then
                    pcall(function() print("[NEXIUM] no apartment owned — buy one manually first") end)
                    mf.IsFarming = false
                    mf.Enabled   = false
                    return
                end
                if not mf.Enabled or stopFlag then mf.IsFarming = false; return end

                local function begin()
                    if not mf.Enabled or stopFlag then mf.IsFarming = false; return end
                    if getgenv().StartApexNoclip then getgenv().StartApexNoclip() end
                    if getgenv().DestroyAllMapCollision then getgenv().DestroyAllMapCollision() end
                    enableAptNoclip()
                    farmCycle(aptPos)
                end

                if getgenv().AutoMask and getgenv().AutoMask.Enabled and getgenv().BuyAndEquipMask then
                    pcall(getgenv().BuyAndEquipMask, begin)
                else
                    begin()
                end
            end)
        end

        local function stopFarm()
            local mf = getgenv().MarshmallowFarm
            stopFlag   = true
            mf.Enabled = false
            task.spawn(function()
                local t = 0
                while mf.CycleActive and t < 20 do task.wait(0.5); t = t + 0.5 end
                mf.IsFarming   = false
                mf.CycleActive = false
                disableAptNoclip()
                getgenv().FirstLamontTeleportDone = false
                if getgenv()._MF_DestroyBP    then getgenv()._MF_DestroyBP()    end
                if getgenv().StopApexNoclip then getgenv().StopApexNoclip() end
                if getgenv().SetNoclip then getgenv().SetNoclip(false) end
            end)
        end

        getgenv()._MF_GetAptPos = getAptTpPos
        getgenv()._MF_FindOrRentApt = findOrRentApt
        getgenv().ToggleMarshmallowFarm = function(state)
            if state then startFarm() else stopFarm() end
        end
    end

    -- the engine's respawn jumps are deliberate: they must not count as deaths
    local origInstant = getgenv().InstantRespawnTP
    if origInstant then
        getgenv().InstantRespawnTP = function(dest)
            PotatoDeathGrace(12)
            return origInstant(dest)
        end
    end
end

local function executeFarmScript()
    CharLock.why = nil
    if not CharLock.acquire("marsh", marshAlive) then
        CharLock.why = "the character is busy (another farm holds it)"
        return
    end
    installMarshEngine()
    local mf = getgenv().MarshmallowFarm

    -- an apartment is needed for the pot: use the one that is rented, or rent one
    local aptPos = getgenv()._MF_GetAptPos and getgenv()._MF_GetAptPos()
    if not aptPos and getgenv()._MF_FindOrRentApt and isFarmRunning then
        notify("No apartment rented yet, renting one...")
        pcall(getgenv()._MF_FindOrRentApt)
        task.wait(1)
        aptPos = getgenv()._MF_GetAptPos()
    end
    if not aptPos then
        CharLock.why = "you do not rent an apartment and none could be rented"
        CharLock.release("marsh")
        return
    end
    if not isFarmRunning then CharLock.release("marsh") return end

    -- Bike TP: our bike spawn and mount, then the engine's bike TP takes over
    if movementMode == "Bike TP" then
        local bike = getPlayerBike()
        if not (bike and bike.Parent) then
            if not requestBikeSpawn(function() return isFarmRunning end) then
                CharLock.why = "the bike did not spawn"
                CharLock.release("marsh")
                return
            end
            bike = getPlayerBike()
        end
        if not (bike and bike.Parent and bikeMount(bike, 12)) then
            CharLock.why = "could not get on the bike"
            CharLock.release("marsh")
            return
        end
    end
    if not isFarmRunning then CharLock.release("marsh") return end

    -- the engine may still be winding down from the previous run
    local waitStart = os.clock()
    while mf.IsFarming and os.clock() - waitStart < 20 and isFarmRunning do task.wait(0.25) end

    mf.ShopClicks = math.max(1, currentBatchAmount or 1)
    marshSetupDone = true
    getgenv().ToggleMarshmallowFarm(true)

    local t0 = os.clock()
    while isFarmRunning do
        mf.ShopClicks = math.max(1, currentBatchAmount or 1)
        if not mf.Enabled and os.clock() - t0 > 2 then
            CharLock.why = "the farm engine stopped by itself"
            break
        end
        task.wait(0.5)
    end
    pcall(getgenv().ToggleMarshmallowFarm, false)
    CharLock.release("marsh")
end

local farmThreadAlive = false

local function startFarm()
    local waited = 0
    while farmThreadAlive and isFarmRunning and waited < 20 do
        task.wait(0.25)
        waited += 0.25
    end
    if farmThreadAlive or not isFarmRunning then return end

    farmThreadAlive = true
    local ok, err = pcall(executeFarmScript)
    farmThreadAlive = false
    CharLock.release("marsh")

    if not ok then
        warn("[Skid Hub] farm error: " .. tostring(err))
    end
    -- The farm loop only ends on its own when setup failed; flip the switch back so it is not left "on".
    if isFarmRunning then
        stopFarm(ok and ("Farm stopped: " .. tostring(CharLock.why or "setup could not finish") .. ".") or ("Marshmallow farm error: " .. string.sub(tostring(err), 1, 160)))
    end
end

