-- ============================================================================
-- MARSHMALLOW FARM ENGINE: the instant-bike-TP script's farm, unchanged (noclip, tween teleport, bike
-- TP, mask, cooking cycle). Only the bike spawn and mount before it starts are ours.
-- ============================================================================
local marshEngineInstalled = false
local function installMarshEngine()
    if marshEngineInstalled then return end
    marshEngineInstalled = true
    local Players        = game:GetService("Players")
    local RunService     = game:GetService("RunService")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local UserInputService = game:GetService("UserInputService")
    local TweenService   = game:GetService("TweenService")
    local VirtualInput   = game:GetService("VirtualInputManager")

    local lp    = Players.LocalPlayer
    local ws    = game:GetService("Workspace")
    local cam   = ws.CurrentCamera

    getgenv().MarshmallowFarm = getgenv().MarshmallowFarm
        or { Enabled = false, IsFarming = false, CycleActive = false, ShopClicks = 1, BuyDelay = 0.14 }
    getgenv().MarshmallowFarm.ShopClicks = 1

    getgenv().AutoMask = getgenv().AutoMask
        or { Enabled = false, Running = false, HasBoughtThisSession = false }

    getgenv().UserNoclipEnabled = getgenv().UserNoclipEnabled or false
    getgenv().LastRespawnTime   = getgenv().LastRespawnTime   or 0
    getgenv().RespawnForceClassicTime = getgenv().RespawnForceClassicTime or 2.6
    getgenv().AutoSelectEnabled = getgenv().AutoSelectEnabled or true
    getgenv().NullT = getgenv().NullT or "Tween"

    getgenv().FarmStatus = getgenv().FarmStatus
        or { Elapsed = 0, StartMoney = nil, MarshmallowSold = 0 }

    getgenv().AntiAFK = getgenv().AntiAFK or { Enabled = true }

    do
        local NoclipParts = {}
        local noclipConn = nil
        local mapSweepDone = false
        local RoadSidewalkFolder = ws:FindFirstChild("Map") and ws.Map:FindFirstChild("Roads/Sidewalks")

        local function SetHiddenProperty(instance, property, value)
            pcall(function()
                if sethiddenproperty then
                    sethiddenproperty(instance, property, value)
                else
                    instance[property] = value
                end
            end)
        end

        -- the player's current vehicle (bike/car) so apex noclip doesn't
        -- disable the wall or the bike itself.
        local function ExclusionsSideWalk_Folder(Part)
            if not Part or not Part:IsA("BasePart") then return true end
            local partName = string.lower(Part.Name or "")
            -- Current seated vehicle (whole model whitelisted)
            local curVeh = nil
            pcall(function()
                local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                if h and h.SeatPart then curVeh = h.SeatPart.Parent end
            end)
            return (RoadSidewalkFolder and Part:IsDescendantOf(RoadSidewalkFolder))
                or (Part.Name == "default")
                or (Part.Name == "Sidewalk")
                or (Part.Name == "Floor")
                or (Part.Name == "Collision")
                or (Part.Name == "QuaterCylinder")
                or (lp.Character and Part:IsDescendantOf(lp.Character))
                or (Part.Parent and Part.Parent:IsA("Model") and Players:GetPlayerFromCharacter(Part.Parent) ~= nil)
                or Part:IsA("VehicleSeat")
                or (Part.Name == "AntiFall_Platform1")
                or (Part.Name == "AntiFall_Platform2")
                or (partName:find("undergroundbp") ~= nil)
                or (partName:find("baseplate") ~= nil)
                or (partName:find("platform") ~= nil)
                or (partName:find("nexium_") ~= nil)           -- v27.36: wall + support
                or (partName:find("antifall") ~= nil)          -- v27.34
                or (curVeh and Part:IsDescendantOf(curVeh))    -- v27.34: own vehicle
        end

        local function Reset_Noclip()
            for part, props in pairs(NoclipParts) do
                if part and part.Parent and part:IsA("BasePart") then
                    SetHiddenProperty(part, "CanCollide", props.CanCollide)
                end
            end
            NoclipParts = {}
            mapSweepDone = false
        end

        local function ApexNoclip()
            local Character = lp.Character
            if not Character then return end
            local Root = Character:FindFirstChild("HumanoidRootPart")
            if not Root then return end
            local Pos = Root.Position
            local radius = 15
            local region = Region3.new(
                Pos - Vector3.new(radius, radius, radius),
                Pos + Vector3.new(radius, radius, radius)
            )
            local ok, parts = pcall(function()
                return ws:FindPartsInRegion3(region, nil, math.huge)
            end)
            if not ok or not parts then return end
            for _, part in ipairs(parts) do
                if part:IsA("BasePart") and not ExclusionsSideWalk_Folder(part) then
                    if not NoclipParts[part] then
                        NoclipParts[part] = { CanCollide = part.CanCollide }
                        SetHiddenProperty(part, "CanCollide", false)
                    elseif part.CanCollide then
                        SetHiddenProperty(part, "CanCollide", false)
                    end
                end
            end
        end

        local function DestroyAllMapCollision()
            for _, part in ipairs(ws:GetDescendants()) do
                if part:IsA("BasePart") and not ExclusionsSideWalk_Folder(part) then
                    if not NoclipParts[part] then
                        NoclipParts[part] = { CanCollide = part.CanCollide }
                    end
                    if part.CanCollide then
                        SetHiddenProperty(part, "CanCollide", false)
                    end
                end
            end
            mapSweepDone = true
            getgenv()._MF_MapNoclipActive = true
        end

        local function StartApexNoclip()
            getgenv()._MF_ApexNoclipActive = true
            DestroyAllMapCollision()
            if noclipConn then return end
            noclipConn = RunService.Stepped:Connect(function()
                if getgenv()._MF_ApexNoclipActive then
                    ApexNoclip()
                    if not mapSweepDone then
                        DestroyAllMapCollision()
                    end
                else
                    if next(NoclipParts) ~= nil then
                        Reset_Noclip()
                    end
                end
            end)
            task.spawn(function()
                while getgenv()._MF_ApexNoclipActive do
                    task.wait(2.5)
                    if getgenv()._MF_ApexNoclipActive then
                        DestroyAllMapCollision()
                    end
                end
            end)
        end

        local function StopApexNoclip()
            getgenv()._MF_ApexNoclipActive = false
            getgenv()._MF_MapNoclipActive = false
            if noclipConn then
                noclipConn:Disconnect()
                noclipConn = nil
            end
            Reset_Noclip()
        end

        getgenv().SetNoclip = function(state)
            getgenv().UserNoclipEnabled = state and true or false
            if state then StartApexNoclip() else StopApexNoclip() end
        end
        getgenv().SetTweenNoclip = function(_) end
        getgenv().CacheCollideData = function() end
        getgenv().ForceCharCollideOn = function() end
        getgenv().ForceNoclipOff = function() end
        getgenv().ReleaseInteractLock = function() end
        getgenv().EnableMapNoclip = function()
            StartApexNoclip()
        end
        getgenv().DisableMapNoclip = function()
            if not (getgenv().MarshmallowFarm and getgenv().MarshmallowFarm.Enabled) then
                StopApexNoclip()
            end
        end
        getgenv().StartApexNoclip = StartApexNoclip
        getgenv().StopApexNoclip = StopApexNoclip
        getgenv().DestroyAllMapCollision = DestroyAllMapCollision
        getgenv()._MF_MapNoclipActive = false
        getgenv()._MF_ApexNoclipActive = false

        -- Noclip now only activates when the farm actually starts cycling
        -- (inside begin() after the bike is detected / farm toggle is on).
        -- Prevents noclip being active while the player is still on foot
        -- going to get the bike.
    end

    do
        local cancelToken = 0
        getgenv().TeleportCancelToken = cancelToken

        local function getLiveChar(timeout)
            local deadline = os.clock() + (timeout or 0)
            repeat
                local char = lp.Character
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if char and hum and hum.Health > 0 and root then
                    return char, hum, root
                end
                if not timeout or timeout <= 0 then break end
                task.wait(0.05)
            until os.clock() >= deadline
            return nil, nil, nil
        end

        local function isCancelled(token)
            return getgenv().TeleportCancelToken ~= token
        end

        local UndergroundBaseplates = {}

        local function spawnBP()
            if next(UndergroundBaseplates) then return true end
            local positions = {
                Vector3.new(0,    -8.2,  0),
                Vector3.new(1321, -8.2,  660),
                Vector3.new(-919, -8.2,  659),
                Vector3.new(-898, -8.2, -652),
                Vector3.new(1364, -8.2, -639),
            }
            -- A 1-billion-stud Part is an obvious exploit signature even
            -- if it's client-only. 4096 is still huge (covers ~1.4km) and
            -- enough to catch the player in any teleport underground.
            for _, pos in ipairs(positions) do
                local name = "UndergroundBP_" .. tostring(pos)
                local existing = ws:FindFirstChild(name)
                if existing then
                    UndergroundBaseplates[existing] = true
                else
                    local bp = Instance.new("Part")
                    bp.Name       = name
                    bp.Size       = Vector3.new(4096, 5, 4096)
                    bp.Position   = pos
                    bp.Anchored   = true
                    bp.CanCollide = true
                    bp.Transparency = 1  -- also invisible so no visual tell
                    bp.BrickColor = BrickColor.new("Dark stone grey")
                    bp.Material   = Enum.Material.Concrete
                    bp.Parent     = ws
                    UndergroundBaseplates[bp] = true
                end
            end
            return true
        end

        local function destroyBP()
            for bp in pairs(UndergroundBaseplates) do
                if bp and bp.Parent then bp:Destroy() end
            end
            UndergroundBaseplates = {}
        end

        local STEP_DIST = 1.5
        local STEP_WAIT = 0.08

        local function moveUnderground(target, token)
            while true do
                if isCancelled(token) then return false end
                local _, _, r = getLiveChar(3)
                if not r then return false end
                local cur  = r.Position
                local dist = (target - cur).Magnitude
                if dist <= STEP_DIST then break end
                local dir  = (target - cur).Unit
                r.CFrame   = CFrame.new(cur + dir * STEP_DIST)
                task.wait(STEP_WAIT)
            end
            local _, _, rf = getLiveChar(1)
            if rf then rf.CFrame = CFrame.new(target) end
            return true
        end

        local inProgress = false

        local function tweenTeleport(dest, token)
            local t0 = tick()
            while inProgress and tick() - t0 < 30 do task.wait(0.05) end
            inProgress = true

            local function finish()
                inProgress = false
            end

            spawnBP()

            local _, _, root = getLiveChar(3)
            if not root then finish(); return false end
            if isCancelled(token) then finish(); return false end

            local underPos  = Vector3.new(root.Position.X, -2.4, root.Position.Z)
            root.CFrame     = CFrame.new(underPos)
            task.wait(0.5)

            if isCancelled(token) then finish(); return false end

            local underDest = Vector3.new(dest.X, -2.4, dest.Z)
            local ok = moveUnderground(underDest, token)
            if not ok then finish(); return false end
            if isCancelled(token) then finish(); return false end

            local _, _, r2 = getLiveChar(3)
            if not r2 then finish(); return false end
            r2.CFrame = CFrame.new(dest)
            task.wait(0.5)

            pcall(function()
                VirtualInput:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
            end)

            finish()
            return true
        end

        getgenv()._MF_DestroyBP = destroyBP
        getgenv()._MF_SpawnBP   = spawnBP

        local INSTANT_DESTINATIONS = {
            [tostring(Vector3.new(532.69, 3.45, 423.12))] = true,
        }

        local function isInstantDest(pos)
            for key in pairs(INSTANT_DESTINATIONS) do
                local x, y, z = key:match("([%-%.%d]+),%s*([%-%.%d]+),%s*([%-%.%d]+)")
                if x then
                    local ref = Vector3.new(tonumber(x), tonumber(y), tonumber(z))
                    if (pos - ref).Magnitude <= 10 then
                        return true
                    end
                end
            end
            return false
        end

        local function instantRespawnTP(dest)
            local _, _, root = getLiveChar(6)
            if not root then return false end

            getgenv()._MF_RespawnTPActive = true

            local charAdded = false
            local conn = lp.CharacterAdded:Connect(function()
                charAdded = true
            end)

            -- The fast-respawn trick that he specifically wants for
            -- buying apartments — fastest possible char death → respawn.
            root.CFrame = CFrame.new(Vector3.new(root.Position.X, 9e9, root.Position.Z))

            local deadline = tick() + 12
            while not charAdded and tick() < deadline do task.wait(0.05) end
            conn:Disconnect()

            if not charAdded then
                getgenv()._MF_RespawnTPActive = false
                return false
            end

            local _, _, r2 = getLiveChar(6)
            if not r2 then
                getgenv()._MF_RespawnTPActive = false
                return false
            end

            local t = tick() + 0.35
            while tick() < t do
                local _, _, r = getLiveChar(1)
                if r then r.CFrame = CFrame.new(dest) end
                task.wait()
            end

            task.wait(0.15)
            getgenv()._MF_RespawnTPActive = false
            return true
        end

        local function forceTweenTeleport(dest)
            local pos
            if typeof(dest) == "CFrame" then pos = dest.Position
            elseif typeof(dest) == "Vector3" then pos = dest
            else return false end
            cancelToken = cancelToken + 1
            getgenv().TeleportCancelToken = cancelToken
            getgenv()._MF_RespawnTPActive = false
            inProgress = false
            task.wait(0.05)
            cancelToken = cancelToken + 1
            getgenv().TeleportCancelToken = cancelToken
            return tweenTeleport(pos, cancelToken)
        end

        local function nullTeleport(dest)
            local pos
            if typeof(dest) == "CFrame"     then pos = dest.Position
            elseif typeof(dest) == "Vector3" then pos = dest
            else return false end

            if isInstantDest(pos) then
                return instantRespawnTP(pos)
            end

            return forceTweenTeleport(pos)
        end

        lp.CharacterAdded:Connect(function()
            cancelToken = cancelToken + 1
            getgenv().TeleportCancelToken = cancelToken
            getgenv().LastRespawnTime = tick()
            destroyBP()
            if getgenv().UserNoclipEnabled and not getgenv()._MF_RespawnTPActive then
                getgenv().CacheCollideData()
                getgenv().SetNoclip(true)
            end
        end)

        getgenv().NullTeleport         = nullTeleport
        getgenv().ForceTweenTeleport   = forceTweenTeleport
        getgenv().InstantRespawnTP     = instantRespawnTP
        getgenv().GetLiveCharacter     = getLiveChar
    end

    -- Detects Humanoid.SeatPart. If seated on a vehicle, teleports
    -- the whole vehicle step-by-step with anti-fall wall, noclip,
    -- and SetNetworkOwner. If not seated, silently falls through to
    -- the normal teleport (no popup, just a quiet F9 print).
    -- Automatically wraps NullTeleport + ForceTweenTeleport so the
    -- farm uses bike-TP whenever possible without any config.
    do
        local Players = game:GetService("Players")
        local lp      = Players.LocalPlayer
        local ws      = game:GetService("Workspace")

        local function quietLog(msg)
            -- Only goes to F9 Client console, no on-screen notification
            pcall(function() print("[NEXIUM] " .. tostring(msg)) end)
        end

        -- Returns seat, vehicle (or nil, nil)
        local function getBikeNow()
            local c = lp.Character
            if not c then return nil, nil end
            local h = c:FindFirstChildOfClass("Humanoid")
            if not h then return nil, nil end
            local s = h.SeatPart
            if not s then return nil, nil end
            local v = s.Parent
            if not v then return nil, nil end
            return s, v
        end

        -- Looks up the player's own bike in workspace.Vehicles or workspace
        local function findOwnBike()
            local vList = ws:FindFirstChild("Vehicles")
            local bikeName = lp.Name .. "'s Car"
            local b = vList and vList:FindFirstChild(bikeName)
            if not b then
                local okF, found = pcall(function()
                    return ws:FindFirstChild(bikeName, true)
                end)
                if okF then b = found end
            end
            return b
        end

        -- Tries to re-seat on own bike if detached
        local function tryReseat()
            local bike = findOwnBike()
            if not bike then return false end
            local ds = bike:FindFirstChild("DriveSeat")
                or bike:FindFirstChildWhichIsA("Seat")
            local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
            if not ds or not hum then return false end
            pcall(function() ds:Sit(hum) end)
            task.wait(0.5)
            local s, v = getBikeNow()
            return s ~= nil and v ~= nil
        end

        -- Was disabling CanCollide on EVERYTHING in range — including the
        -- NEXIUM_BikeWall I just placed to catch the bike. Bike would then
        -- fall through its own safety wall. Now we skip:
        --   • NEXIUM_BikeWall   (the wall this TP places)
        --   • UndergroundBP_*   (farm underground baseplates)
        --   • anything named like Baseplate / Platform / AntiFall / Sidewalk
        --   • the vehicle itself + its descendants
        --   • other players' characters
        local _bikeNoclipCache = {}

        local function isWhitelistedPart(p, veh)
            if not p or not p.Name then return true end
            local nm = p.Name
            local nml = nm:lower()
            if nml:find("nexium_", 1, true) then return true end  -- v27.36: wall + support
            if nml:find("undergroundbp", 1, true) then return true end
            if nml:find("baseplate",     1, true) then return true end
            if nml:find("platform",      1, true) then return true end
            if nml:find("antifall",      1, true) then return true end
            if nm  == "Sidewalk" or nm == "Floor" or nm == "default"
               or nm == "Collision" or nm == "QuaterCylinder" then
                return true
            end
            if p:IsA("VehicleSeat") then return true end
            -- Own vehicle & its descendants
            if veh and (p == veh or p:IsDescendantOf(veh)) then return true end
            -- Own character
            if lp.Character and p:IsDescendantOf(lp.Character) then return true end
            -- Other players' characters
            if p.Parent and p.Parent:IsA("Model")
               and Players:GetPlayerFromCharacter(p.Parent) then
                return true
            end
            return false
        end

        local function noclipAroundBike(root, radius, veh)
            if not root then return end
            radius = radius or 10
            local ok, parts = pcall(function()
                local region = Region3.new(
                    root.Position - Vector3.new(radius, radius, radius),
                    root.Position + Vector3.new(radius, radius, radius)
                )
                return ws:FindPartsInRegion3(region, nil, math.huge)
            end)
            if not ok or not parts then return end
            for _, p in ipairs(parts) do
                if p:IsA("BasePart") and not isWhitelistedPart(p, veh) then
                    if p.CanCollide and _bikeNoclipCache[p] == nil then
                        _bikeNoclipCache[p] = { CanCollide = true }
                        pcall(function() p.CanCollide = false end)
                    end
                end
            end
        end

        local function restoreBikeNoclip()
            for p in pairs(_bikeNoclipCache) do
                if p and p.Parent then
                    pcall(function() p.CanCollide = true end)
                end
            end
            _bikeNoclipCache = {}
        end

        -- Added slow descent/ascent, velocity dampening, and temporary
        -- anchor at the final position so the bike doesn't fall over
        -- while the player interacts.
        local _supportPlatform = nil

        -- Anchoring every descendant breaks welds/joints and causes the
        -- bike to "destroy itself" when you release control.
        -- One anchored root part is enough — the welds keep the rest
        -- attached to it rigidly.
        local _anchoredPrimary = {}

        local function damp(v)
            if not v then return end
            local primary = v.PrimaryPart or v:FindFirstChildWhichIsA("Seat")
                or v:FindFirstChildWhichIsA("BasePart")
            if primary then
                pcall(function()
                    primary.AssemblyLinearVelocity  = Vector3.zero
                    primary.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end

        local function anchorVehicle(v, state)
            if not v then return end
            local primary = v.PrimaryPart or v:FindFirstChildWhichIsA("Seat")
                or v:FindFirstChildWhichIsA("BasePart")
            if not primary then return end
            if state then
                if _anchoredPrimary[v] == nil then
                    _anchoredPrimary[v] = primary.Anchored
                end
                pcall(function() primary.Anchored = true end)
            else
                local orig = _anchoredPrimary[v]
                if orig ~= nil then
                    pcall(function() primary.Anchored = orig end)
                end
                _anchoredPrimary[v] = nil
            end
        end

        -- Gradual vertical move: animates Y over time while XZ stays fixed.
        -- Default speed is slow (18 studs/s) per user request.
        local function verticalMove(v, fromY, toY, speed)
            speed = speed or 18  -- slow
            local start = v:GetPivot().Position
            local total = math.abs(toY - fromY)
            if total < 0.5 then return true end
            local stepTime = 0.03
            local perStep  = speed * stepTime
            local steps    = math.ceil(total / perStep)
            for i = 1, steps do
                local s2, v2 = getBikeNow()
                if not s2 or not v2 then return false end
                local a = math.min(i / steps, 1)
                local y = fromY + (toY - fromY) * a
                local _, curRot = v2:GetPivot():ToOrientation()
                local newCF = CFrame.new(start.X, y, start.Z)
                    * CFrame.Angles(0, curRot, 0)
                pcall(function() v2:PivotTo(newCF) end)
                local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function()
                        hrp.CFrame = newCF
                        hrp.AssemblyLinearVelocity  = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
                damp(v2)
                noclipAroundBike(v2.PrimaryPart or s2, 10, v2)
                task.wait(stepTime)
            end
            return true
        end

        -- v27.41: new descent approach — noclip the bike itself and let
        -- gravity do the work. No forced CFrame descent, no walls needed.
        -- Horizontal moves use steppedMove, ascents use verticalMove (smooth).
        local _bikePartCache = {}

        local function setBikeNoclip(v, on)
            if not v then return end
            if on then
                for _, p in ipairs(v:GetDescendants()) do
                    if p:IsA("BasePart") then
                        if _bikePartCache[p] == nil then
                            _bikePartCache[p] = p.CanCollide
                        end
                        pcall(function() p.CanCollide = false end)
                    end
                end
            else
                for p, orig in pairs(_bikePartCache) do
                    if p and p.Parent then
                        pcall(function() p.CanCollide = orig end)
                    end
                end
                _bikePartCache = {}
            end
        end

        local function steppedMoveSimple(dest, speed)
            speed = speed or 200
            local s, v = getBikeNow()
            if not s or not v then return false end
            local startPos = v:GetPivot().Position
            local total = (startPos - dest).Magnitude
            if total < 3 then return true end
            local stepTime = 0.02
            local perStep = speed * stepTime
            local steps = math.ceil(total / perStep)
            pcall(function()
                (v.PrimaryPart or s):SetNetworkOwner(lp)
            end)
            task.wait(0.05)

            local lastPos = startPos
            local stuckCount, detachCount = 0, 0

            for i = 1, steps do
                local s2, v2 = getBikeNow()
                if not s2 or not v2 then
                    detachCount = detachCount + 1
                    if detachCount <= 3 then
                        tryReseat(); task.wait(0.2)
                        s2, v2 = getBikeNow()
                    end
                    if not s2 or not v2 then return false end
                end
                local a = math.min(i / steps, 1)
                local p = startPos:Lerp(dest, a)
                pcall(function()
                    v2:PivotTo(CFrame.new(p))
                    local ch = lp.Character
                    local hm = ch and ch:FindFirstChildOfClass("Humanoid")
                    if hm and not hm.SeatPart then
                        local ds = v2:FindFirstChild("DriveSeat")
                            or v2:FindFirstChildWhichIsA("Seat")
                        if ds then pcall(function() ds:Sit(hm) end) end
                    end
                end)
                damp(v2)
                task.wait(stepTime)

                local s3, v3 = getBikeNow()
                if s3 and v3 then
                    local cur = v3:GetPivot().Position
                    if (cur - lastPos).Magnitude < 0.5 then
                        stuckCount = stuckCount + 1
                        if stuckCount >= 5 then
                            tryReseat(); stuckCount = 0; task.wait(0.2)
                        end
                    else
                        stuckCount = 0
                    end
                    lastPos = cur
                end
            end
            return true
        end

        -- v27.42: super-fast bike TP.
        -- Quick jerk down + brief noclip + instant CFrame to target.
        -- No 4-second waits (that was breaking the cooking timing and
        -- causing W/G/S to not reach the pot). The whole TP takes under
        -- 0.6 seconds now instead of 6+ seconds.
        local function bikeTP(target)
            local seat, veh = getBikeNow()
            if not seat then
                if not tryReseat() then
                    quietLog("not on bike — bike TP skipped")
                    return false
                end
                seat, veh = getBikeNow()
                if not seat then return false end
            end

            if typeof(target) == "CFrame" then target = target.Position end
            if typeof(target) ~= "Vector3" then return false end

            pcall(function()
                (veh.PrimaryPart or seat):SetNetworkOwner(lp)
            end)

            -- STEP 1: quick noclip-fall (jalosito rapido, no 4s)
            setBikeNoclip(veh, true)
            task.wait(0.3)
            setBikeNoclip(veh, false)
            task.wait(0.1)

            -- STEP 2: direct CFrame to target with 2-stud side offset.
            -- Moves the ENTIRE vehicle in one frame (no gradual slide,
            -- no smooth rise). Instant.
            local s2, v2 = getBikeNow()
            if s2 and v2 then
                local primary = v2.PrimaryPart or s2
                local oldCF = primary.CFrame

                -- Save offsets of all parts relative to primary so welds
                -- stay intact after the big CFrame move
                local offsets = {}
                for _, part in pairs(v2:GetDescendants()) do
                    if part:IsA("BasePart") then
                        offsets[part] = oldCF:ToObjectSpace(part.CFrame)
                    end
                end

                -- Side offset 2 studs so bike doesn't overlap the pot
                local potCF = CFrame.new(target.X, target.Y, target.Z)
                local sideOffset = potCF.RightVector * 2
                local sideTarget = Vector3.new(
                    target.X + sideOffset.X,
                    target.Y,
                    target.Z + sideOffset.Z
                )
                local _, curRot = oldCF:ToOrientation()
                local newCF = CFrame.new(sideTarget) * CFrame.Angles(0, curRot, 0)

                pcall(function() primary.CFrame = newCF end)
                for part, off in pairs(offsets) do
                    if part ~= primary then
                        pcall(function() part.CFrame = newCF * off end)
                    end
                end

                local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function()
                        hrp.CFrame = newCF
                        hrp.AssemblyLinearVelocity  = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
                damp(v2)
            end

            return true
        end

        -- Expose for direct use
        getgenv().BikeTP   = bikeTP
        getgenv().IsOnBike = function() return (getBikeNow()) ~= nil end

        -- Wrap existing teleport entry points so the farm transparently
        -- uses bike TP whenever the player is sitting on a bike.
        local origNullTeleport       = getgenv().NullTeleport
        local origForceTweenTeleport = getgenv().ForceTweenTeleport
        local origInstantRespawnTP   = getgenv().InstantRespawnTP

        getgenv().NullTeleport = function(dest)
            if getBikeNow() then
                local ok = bikeTP(dest)
                if ok then return true end
            end
            if origNullTeleport then return origNullTeleport(dest) end
        end

        getgenv().ForceTweenTeleport = function(dest)
            if getBikeNow() then
                local ok = bikeTP(dest)
                if ok then return true end
            end
            if origForceTweenTeleport then return origForceTweenTeleport(dest) end
        end

        -- InstantRespawnTP would kill the character which dismounts from
        -- the bike. If on a bike, use bikeTP instead so we stay seated.
        getgenv().InstantRespawnTP = function(dest)
            if getBikeNow() then
                local ok = bikeTP(dest)
                if ok then return true end
            end
            if origInstantRespawnTP then return origInstantRespawnTP(dest) end
        end
    end

