-- ===== Multi-farm core (v80) =====
-- One character can only be in one place, so the farms take turns. A farm holds the character
-- ("CharLock") for its active steps and hands it over while its pot is cooking.
local PotatoRunning = false      -- owned by the Potato module below
local DeathGraceUntil = 0        -- deliberate respawns (sky teleports) must not count as deaths
local marshSetupDone = false     -- Multi Farm starts the potato farm once this is true
local marshCookCam = false       -- the Marshmallow farm wants its far camera while it cooks

local function marshAlive()
    return isFarmRunning
end

local CharLock = { why = nil, tpGap = 1.5, lastTP = 0, owner = nil, queue = {}, alive = {}, hooks = {}, bikeY = -5, bikeSpeed = 260, stayUnder = false, walkSpeed = 32, shortHop = true, standLift = 2, reachLift = nil, instantPrompts = true, pointer = true }
CharLock.alive.marsh = marshAlive
CharLock.alive.potato = function() return PotatoRunning end

function CharLock.contended()
    return #CharLock.queue > 0
end

-- Blocks (in order of arrival) until the character is free. Returns false if the caller's farm
-- was switched off while it waited.
function CharLock.acquire(name, aliveFn)
    if CharLock.owner == name then return true end
    local ticket = { name = name, alive = aliveFn }
    table.insert(CharLock.queue, ticket)
    while true do
        -- drop waiting tickets whose farm was switched off, so a stale one can never block the line
        while CharLock.queue[1] and CharLock.queue[1] ~= ticket
            and CharLock.queue[1].alive and not CharLock.queue[1].alive() do
            table.remove(CharLock.queue, 1)
        end
        if aliveFn and not aliveFn() then
            local at = table.find(CharLock.queue, ticket)
            if at then table.remove(CharLock.queue, at) end
            return false
        end
        local owner = CharLock.owner
        local ownerAlive = owner and CharLock.alive[owner]
        if owner and ownerAlive and not ownerAlive() then
            -- the other farm was switched off while it held the character
            CharLock.owner = nil
            owner = nil
        end
        if owner == nil and CharLock.queue[1] == ticket then
            table.remove(CharLock.queue, 1)
            CharLock.owner = name
            local hook = CharLock.hooks[name]
            if hook then pcall(hook) end
            return true
        end
        task.wait(0.1)
    end
end

function CharLock.release(name)
    if CharLock.owner == name then
        CharLock.owner = nil
    end
end

-- Whichever farm currently holds the character decides whether movement helpers keep going.
local function farmAlive()
    local owner = CharLock.owner
    if owner == "potato" then return PotatoRunning == true end
    if owner == "marsh" then return isFarmRunning end
    return isFarmRunning or PotatoRunning == true
end

local function PotatoDeathGrace(seconds)
    DeathGraceUntil = math.max(DeathGraceUntil, os.clock() + (seconds or 8))
end

