        if not humanoid then return false end
        if not humanoid.SeatPart then return true end
        attempt += 1
        if attempt % 2 == 1 then
            humanoid.Sit = false
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
        else
