local function bikeMount(bike, timeout)
    local deadline = os.clock() + (timeout or 12)
    repeat
        if not farmAlive() or not (bike and bike.Parent) then return false end
        local _, humanoid, root = getCharacterParts()
        local seat = getBikeSeat(bike)
        if not (humanoid and root and seat) then
            task.wait(0.25)
            continue
        end
        if humanoid.SeatPart == seat then return true end

        if (root.Position - seat.Position).Magnitude > 8 then
            if not approachUnderBike(bike) then
                task.wait(0.3)
                continue
            end
        else
            root.CFrame = CFrame.new(bikeSeatSide(seat) + Vector3.new(0, 2.5, 0))
            task.wait(0.1)
        end

        -- fire the seat's own prompt every frame until seated (up to 5s per round)
        local roundStart = os.clock()
        local roundEnd = roundStart + 5
        local lastSit = 0
        repeat
            if not farmAlive() or not (bike and bike.Parent) then return false end
            local _, hum = getCharacterParts()
            if hum and hum.SeatPart then break end
            local s2 = getBikeSeat(bike)
            local attachment = s2 and s2:FindFirstChild("Attachment")
            local prompt = (attachment and attachment:FindFirstChildOfClass("ProximityPrompt"))
                or (s2 and s2:FindFirstChildWhichIsA("ProximityPrompt", true))
            if prompt then
                prompt.Enabled = true
                prompt.MaxActivationDistance = 100
                prompt.RequiresLineOfSight = false
                if type(fireproximityprompt) == "function" then
                    pcall(fireproximityprompt, prompt, 0, true)
                end
            end
            if s2 and hum and os.clock() - roundStart > 0.8 and os.clock() - lastSit > 0.5 then
                lastSit = os.clock()
                pcall(function() s2:Sit(hum) end)
            end
            task.wait()
        until os.clock() >= roundEnd
        local _, hum = getCharacterParts()
        if hum and hum.SeatPart then return true end
        bikeHoldE(0.8)
    until os.clock() >= deadline
    local _, humanoid = getCharacterParts()
    local seat = getBikeSeat(bike)
    return humanoid ~= nil and seat ~= nil and humanoid.SeatPart == seat
end

-- Shared Bike TP movement: instant, copied from the known-good instant bike TP (it does not get the
-- rider kicked off): quick noclip so the bike settles, collisions back on, then the whole bike (every
-- part, keeping the welds' offsets) and the rider are moved in one frame to the target with the same
-- 2-stud side offset. Reaching the bike and sitting on it is bikeMount's job.
local function bikeTweenTo(bike, destination)
    if not (bike and bike.Parent and farmAlive()) then return false end
    local target = typeof(destination) == "CFrame" and destination.Position or destination
    if typeof(target) ~= "Vector3" then return false end

    local function seatedNow()
        local _, humanoid = getCharacterParts()
        local seat = getBikeSeat(bike)
        return humanoid ~= nil and seat ~= nil and humanoid.SeatPart == seat
    end
    local function damp()
        pcall(function()
            local primary = bike.PrimaryPart or getBikeSeat(bike)
            primary.AssemblyLinearVelocity = Vector3.zero
            primary.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    if not seatedNow() and not bikeMount(bike, 12) then return false end
    if not farmAlive() or not (bike and bike.Parent) then return false end

    -- keep a pause between two bike teleports (too many in a row got the rider kicked)
    local pause = (CharLock.lastTP or 0) + (CharLock.tpGap or 1.5) - os.clock()
    if pause > 0 then task.wait(pause) end
    if not farmAlive() or not (bike and bike.Parent) then return false end

    pcall(function() (bike.PrimaryPart or getBikeSeat(bike)):SetNetworkOwner(LocalPlayer) end)

    -- STEP 1: quick noclip, then collisions back
    local cache = {}
    for _, part in ipairs(bike:GetDescendants()) do
        if part:IsA("BasePart") then
            cache[part] = part.CanCollide
            pcall(function() part.CanCollide = false end)
        end
    end
    task.wait(0.3)
    for part, state in pairs(cache) do
        if part and part.Parent then pcall(function() part.CanCollide = state end) end
    end
    task.wait(0.1)

    if not farmAlive() or not (bike and bike.Parent) then return false end
    if not seatedNow() and not bikeMount(bike, 8) then return false end

    -- STEP 2: the whole vehicle in one frame
    local seat = getBikeSeat(bike)
    local primary = bike.PrimaryPart or seat
    if not primary then return false end
    local oldCF = primary.CFrame
    local offsets = {}
    for _, part in ipairs(bike:GetDescendants()) do
        if part:IsA("BasePart") then offsets[part] = oldCF:ToObjectSpace(part.CFrame) end
    end
    local sideTarget = Vector3.new(target.X + 2, target.Y, target.Z)
    local _, curRot = oldCF:ToOrientation()
    local newCF = CFrame.new(sideTarget) * CFrame.Angles(0, curRot, 0)

    pcall(function() primary.CFrame = newCF end)
    for part, off in pairs(offsets) do
        if part ~= primary then pcall(function() part.CFrame = newCF * off end) end
    end
    local _, _, root = getCharacterParts()
    if root then
        pcall(function()
            root.CFrame = newCF
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    damp()
    CharLock.lastTP = os.clock()
    return farmAlive()
end


