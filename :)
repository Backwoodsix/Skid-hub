    -- Tries each pot until one starts cooking. The character is only held while it is walking
    -- between pots; the wait for a free pot is spent without it.
    local function FindAndUseFreePot()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local origin = hrp and hrp.Position or POTS[1]
        local sorted = {}
        for _, pos in ipairs(POTS) do
            table.insert(sorted, { pos = pos, dist = (pos - origin).Magnitude })
        end
        table.sort(sorted, function(a, b) return a.dist < b.dist end)
        for _, entry in ipairs(sorted) do
            if not PotatoRunning then return nil end
            if not Travel(entry.pos, "Probando olla...") then return nil end
            local potPrompt = FindPromptNear(entry.pos, 6)
            if potPrompt then
                FirePromptSimple(potPrompt, 0)
                task.wait(0.25)
                FirePromptSimple(potPrompt, 0)
                local isCooking = false
                for _ = 1, 8 do
                    task.wait(0.3)
                    if CheckCookingMessage() then
                        isCooking = true
                        break
                    end
                end
                if isCooking then
                    return entry.pos, potPrompt
                else
                    task.wait(0.3)
                end
            end
        end
        -- A whole round without a single pot reacting: from under the map this usually means the
        -- player is too far below the prompts, so stand 2 studs closer for the next round.
        if CharLock.stayUnder and isBikeMode() then
            local base = CharLock.standLift or 0
            local reach = math.max(CharLock.reachLift or base, base)
            if reach < 9 then
                CharLock.reachLift = math.min(9, reach + 2)
                notify("Pots did not react, reaching higher (height " .. tostring(CharLock.reachLift) .. ")")
            end
        end
        PRelease()
        local waited = 0
        while PotatoRunning and waited < 10 do
            task.wait(0.5)
            waited += 0.5
        end
        if not PotatoRunning then return nil end
        if not PAcquire() then return nil end
        return FindAndUseFreePot()
    end

    -- ------------------------------------------------------------------ one potato -> one bag of chips
    -- The cycle is a fixed list of steps: clipboard -> cutting -> bag -> mixing -> pot -> cooking ->
    -- collecting. A step that fails is repeated on its own (the cycle is never restarted from the
    -- top), the other farm may take the character between steps, and every step travels back to its
    -- own station and re-equips what it needs, so the order always holds.
    local CYCLE_NAMES = { "clipboard", "cutting", "bag", "mixing", "pot", "cooking", "collecting" }
    local cycleStep = 1
    local cycleFails = 0
    local needRebuy = false
    local potPos, potPrompt, potStartedAt = nil, nil, 0

    local function DoCycleStep(step)
        if step == 1 then
            if CountPotato() < 1 or CountExactTool("Flour") < 1 then
                needRebuy = true
                return false
            end
            if not Travel(ClipboardPos, "Clipboard...") then return false end
            FirePromptSimple(GetClipboardPrompt() or FindPromptNear(ClipboardPos, 6), 0)
            task.wait(1.4)
            return PotatoRunning
        elseif step == 2 then
            if not EquipPotatoLoose() then
                print("[Potato] could not find the potato to equip, continuing anyway")
            end
            if not Travel(CUTTERS[1], "Cortando papa...") then return false end
            local cutterPrompt = FindPromptNear(CUTTERS[1], 6) or FindPromptNear(CUTTERS[1], 12)
            if cutterPrompt then
                FirePromptSimple(cutterPrompt, 0)
                task.wait(0.35)
                FirePromptSimple(cutterPrompt, 0)
            end
            task.wait(CINE_WAIT)
            return PotatoRunning
        elseif step == 3 then
            if not Travel(BagPos, "Bolsa...") then return false end
            FireBagStep()
            return PotatoRunning
        elseif step == 4 then
            if not EquipToolExact("Flour") then
                needRebuy = true
                return false
            end
            if not Travel(BOWLS[1], "Mezclando...") then return false end
            FirePromptSimple(FindPromptNear(BOWLS[1], 6), 0)
            task.wait(CINE_WAIT)
            return PotatoRunning
        elseif step == 5 then
            local pos, prompt = FindAndUseFreePot()
            if not pos then return false end
            potPos, potPrompt, potStartedAt = pos, prompt, tick()
            return true
        elseif step == 6 then
            -- The pot cooks on its own: give the character away as soon as the other farm asks for it.
            while tick() - potStartedAt < COOK_WAIT do
                if not PotatoRunning then return false end
                if CharLock.owner == "potato" and CharLock.contended() then
                    PRelease()
                end
                task.wait(0.5)
            end
            return true
        else
            local _, _, root = getCharacterParts()
            if root and potPos then
                local flat = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(potPos.X, potPos.Z)).Magnitude
                if flat > 25 then
                    if not Travel(potPos, "Volviendo a la olla...") then return false end
                end
            end
            local prompt = potPrompt
            if not (prompt and prompt.Parent) then prompt = potPos and FindPromptNear(potPos, 5) or nil end
            FirePromptSimple(prompt, 0)
            task.wait(0.5)
            FirePromptSimple(prompt, 0)
            task.wait(2.2)
            return PotatoRunning
        end
    end

    local function RunOneCycle()
        while PotatoRunning and cycleStep <= #CYCLE_NAMES do
            local step = cycleStep
            -- the cooking wait (step 6) needs no character; every other step does
            if step ~= 6 and not PAcquire() then return false end
            local ok = DoCycleStep(step)
            if not PotatoRunning then return false end
            if ok then
                cycleStep += 1
                cycleFails = 0
                if step <= 4 then PYield() end
            else
                if needRebuy then return false end
                cycleFails += 1
                if cycleFails >= 5 then
                    Fail("Potato farm stopped: the " .. CYCLE_NAMES[step] .. " step failed 5 times in a row.")
                    return false
                end
                PYield()
                task.wait(1)
            end
        end
        if cycleStep > #CYCLE_NAMES then
            cycleStep = 1
            PYield()
            return true
        end
        return false
    end

    -- ------------------------------------------------------------------ selling
    local function SubirAlMapa()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local targetY = math.max(originalY > 0 and originalY or 5, 5)
        if not currentPlatform or not currentPlatform.Parent then
            if hrp then
                local startY = hrp.Position.Y
                local dist = math.abs(targetY - startY)
                local secs = math.clamp(dist / 6, 4.5, 14)
                local t0 = tick()
                while tick() - t0 < secs do
                    if not hrp.Parent then break end
                    local a = math.clamp((tick() - t0) / secs, 0, 1)
                    local y = startY + (targetY - startY) * a
                    hrp.CFrame = CFrame.new(hrp.Position.X, y, hrp.Position.Z)
                    pcall(function()
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end)
                    task.wait(0.05)
                end
                if hrp.Parent then
                    hrp.CFrame = CFrame.new(hrp.Position.X, targetY, hrp.Position.Z)
                end
            end
            return
        end
        local px, pz = currentPlatform.Position.X, currentPlatform.Position.Z
        local startY = currentPlatform.Position.Y
        local destPlatformY = targetY - 4.3
        local vertUp = math.abs(destPlatformY - startY)
        local upSeconds = math.clamp(vertUp / 6, 5.0, 16)
        local up = TweenService:Create(currentPlatform,
            TweenInfo.new(upSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { CFrame = CFrame.new(px, destPlatformY, pz) })
        up:Play()
        up.Completed:Wait()
        task.wait(0.35)
        if hrp and hrp.Parent then
            pcall(function()
                hrp.CFrame = CFrame.new(px, targetY, pz)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        DestroyPlatform()
        task.wait(0.2)
    end

