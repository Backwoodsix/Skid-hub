-- Fresh character handles every time; returns nils while dead so callers never touch a stale root.
local function getCharacterParts()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not (humanoid and root) or humanoid.Health <= 0 then
        return character, nil, nil
    end
    return character, humanoid, root
end

local function getPlayerBike()
    local vehicles = Workspace:FindFirstChild("Vehicles")
    return vehicles and vehicles:FindFirstChild(LocalPlayer.Name .. "'s Car")
end

-- Moves the character; while seated on the own bike the whole bike moves with it so the rider is
-- never knocked off the seat.
local function setRootCFrame(cf)
    local _, humanoid, root = getCharacterParts()
    if not root then return false end
    local seat = humanoid and humanoid.SeatPart
    local ownBike = getPlayerBike()
    if seat and ownBike and seat:IsDescendantOf(ownBike) then
        local delta = cf.Position - root.Position
        pcall(function() ownBike:PivotTo(ownBike:GetPivot() + delta) end)
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        return true
    end
    root.CFrame = cf
    return true
end

local function getBikeSeat(bike)
    if not (bike and bike.Parent) then return nil end
    local seat = bike:FindFirstChild("DriveSeat", true)
    if seat and seat:IsA("BasePart") then return seat end
    return bike:FindFirstChildWhichIsA("VehicleSeat", true) or bike:FindFirstChildWhichIsA("Seat", true)
end

local function setBikeAnchored(bike, state)
    if not (bike and bike.Parent) then return end
    for _, part in ipairs(bike:GetDescendants()) do
        if part:IsA("BasePart") then part.Anchored = state end
    end
end

-- Gets the bike spawned at the dealership, using the sequence that is known to work: respawn jump
-- (straight up, same X/Z), a fixed 2s wait, wait for the live character, go to the bike NPC, wait 3s,
-- send the spawn request ONCE, wait 2s and poll for the bike. The request is not re-sent while waiting
-- (it can toggle the bike off again); it is only repeated after a full poll found no bike.
local BIKE_NPC_POS = Vector3.new(727.77, 3.70, 448.77)
local function requestBikeSpawn(alive)
    local existing = getPlayerBike()
    if existing and existing.Parent then return true end
    for attempt = 1, 2 do
        if not alive() then return false end

        if attempt == 1 and not hasFarmItems() then
            local _, _, root = getCharacterParts()
            if root then
                PotatoDeathGrace(20)
                root.CFrame = CFrame.new(root.Position.X, 9e9, root.Position.Z)
                task.wait(2)
                local deadline = os.clock() + 6
                while os.clock() < deadline and alive() do
                    local _, _, r = getCharacterParts()
                    if r then break end
                    task.wait(0.05)
                end
            end
        end

        if not alive() then return false end
        setRootCFrame(CFrame.new(BIKE_NPC_POS))
        task.wait(3)
        if not alive() then return false end

        local events = ReplicatedStorage:FindFirstChild("RemoteEvents")
        local remote = events and events:WaitForChild("ReliableRemoteEvent", 5)
        if remote then
            pcall(function() remote:FireServer(buffer.fromstring("\015\001\001")) end)
        end
        task.wait(2)

        local pollEnd = os.clock() + 10
        while os.clock() < pollEnd and alive() do
            local b = getPlayerBike()
            if b and b.Parent then
                task.wait(0.4)
                return true
            end
            task.wait(0.3)
        end
    end
    return false
end

