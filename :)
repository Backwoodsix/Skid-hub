    -- One sitter at a time; the character is only held while it is at that sitter.
    local function DeliverToSitters()
        local chipsLeft = CountAnyChips()
        if chipsLeft <= 0 then return false end
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local origin = hrp and hrp.Position or SITTERS[1].pos
        local ordered = {}
        for _, s in ipairs(SITTERS) do table.insert(ordered, s) end
        table.sort(ordered, function(a, b)
            return (a.pos - origin).Magnitude < (b.pos - origin).Magnitude
        end)

        local entregadas = 0

        local function deliverTo(s)
            if s.clearBaseFrame then ClearRiverParkBaseFrame(s.pos, 100) end
            if not Travel(s.pos, "Entregando a " .. s.name) then return end
            task.wait(0.2)
            if not EquipAnyChips() then return end
            task.wait(0.3)
            local prompt = GetSitterPrompt(s.name) or FindPromptNear(s.pos, 12)
            if not prompt then return end
            local chipsBefore = CountAnyChips()
            local moneyBefore = PotatoMoney()
            FirePromptSimple(prompt, 0)
            task.wait(0.35)
            FirePromptSimple(prompt, 0)
            task.wait(2.0)
            local dialogue = PlayerGui:FindFirstChild("DialogueUI")
            if dialogue then
                local list = dialogue:FindFirstChild("MainFrame")
                    and dialogue.MainFrame:FindFirstChild("ResponseFrame")
                    and dialogue.MainFrame.ResponseFrame:FindFirstChild("List")
                if list then
                    local one = list:FindFirstChild("1")
                    if one then forceClick(one) task.wait(0.6) end
                end
            end
            task.wait(0.7)
            local chipsAfter = CountAnyChips()
            if chipsAfter < chipsBefore then
                entregadas += 1
                ChipsSold += (chipsBefore - chipsAfter)
                task.spawn(function()
                    local best = 0
                    for _ = 1, 20 do
                        task.wait(0.35)
                        local now = PotatoMoney()
                        local gained = now - moneyBefore
                        if gained > best then best = gained end
                        if best > 0 then
                            task.wait(0.4)
                            now = PotatoMoney()
                            best = math.max(best, now - moneyBefore)
                            break
                        end
                    end
                    if best > 0 then
                        TotalMoneyMade = TotalMoneyMade + best
                    end
                end)
            end
        end

        for _, s in ipairs(ordered) do
            if not PotatoRunning then break end
            chipsLeft = CountAnyChips()
            if chipsLeft <= 0 then break end
            if not PAcquire() then break end
            deliverTo(s)
            PYield()
            if entregadas >= ChipsMade then break end
        end
        return entregadas > 0
    end

    -- ------------------------------------------------------------------ main loop
    local function FarmLoop()
        while PotatoRunning do
            local cantidadObjetivo = math.clamp(math.floor(farmAmount or 5), 1, 12)
            ChipsMade = 0

            if CountExactTool("Flour") < cantidadObjetivo or CountPotato() < cantidadObjetivo then
                if not PAcquire() then break end
                if not FarTravel(LuciaPos, "Lucia...") then
                    PYield()
                    if not PotatoRunning then break end
                    task.wait(2)
                    continue
                end
                if not AutoBuyIngredients(cantidadObjetivo) then
                    SetStatus("Fallo compra — reintentando...")
                    PYield()
                    task.wait(1.5)
                    continue
                end
                PYield()
            end
            if not PotatoRunning then break end

            local made = 0
            while PotatoRunning and made < cantidadObjetivo do
                local ok = RunOneCycle()
                if not PotatoRunning then break end
                if ok then
                    made += 1
                    ChipsMade += 1
                    CycleCount += 1
                elseif needRebuy then
                    -- the ingredients are gone (death / wipe): sell what exists, then buy again
                    needRebuy = false
                    cycleStep = 1
                    break
                else
                    PYield()
                    task.wait(1)
                end
            end
            if not PotatoRunning then break end

            if not PAcquire() then break end
            if not isBikeMode() then SubirAlMapa() end
            MakeSpicy()
            PYield()
            task.wait(0.5)

            local ventas = 0
            repeat
                ventas += 1
                DeliverToSitters()
                task.wait(0.6)
            until not PotatoRunning or CountAnyChips() <= 0 or ventas >= 3

            if CountAnyChips() > 0 then
                print("[Potato] " .. tostring(CountAnyChips()) .. " chips were left unsold")
            end
            task.wait(0.5)
        end
        pcall(function()
            if CharLock.owner == "potato" and isProtecting and currentPlatform then ForceGoUp() end
        end)
        PRelease()
        SetStatus("Detenido")
    end

