            return string.format("%.1fM", n / 1e6)
        elseif n >= 1e3 then
            return string.format("%.1fK", n / 1e3)
        end
        return tostring(n)
    end

    task.spawn(function()
        while sessionAlive() do
            pcall(function()
                local show = PotatoRunning
                if potatoBlock.Visible ~= show then
                    potatoBlock.Visible = show
                    statusFrame.Size = UDim2.new(0, 250, 0, show and (BLOCK_Y + BLOCK_H) or PANEL_BASE_H)
                end
                pCycle.Text = string.format("Cycle: %d   Made: %d   Sold: %d", CycleCount, ChipsMade, ChipsSold)
                pItems.Text = string.format("Flour: %d | Potato: %d | Chips: %d", CountExactTool("Flour"), CountPotato(), CountAnyChips())
                pEarned.Text = "Earned: $" .. fmtMoney(TotalMoneyMade)
                pStatus.Text = "Status: " .. (PotatoRunning and PublicStatus or "Idle")
                local owner = CharLock.owner
                local who = owner == "marsh" and "Marshmallow" or owner == "potato" and "Potato" or "-"
                pMode.Text = "Mode: " .. movementMode .. "  |  Control: " .. who
                if PotatoRunning and FarmStartTime > 0 then
                    local elapsed = math.floor(tick() - FarmStartTime)
                    pTime.Text = string.format("Time Ran: %02d:%02d:%02d", math.floor(elapsed / 3600), math.floor((elapsed % 3600) / 60), elapsed % 60)
                else
                    pTime.Text = "Time Ran: 00:00:00"
                end
            end)
            task.wait(0.4)
        end
    end)

    -- ------------------------------------------------------------------ public API
    function API.SetAmount(v)
        farmAmount = math.clamp(math.floor(tonumber(v) or 5), 1, 12)
    end

    function API.SetMovement(v)
        if v == "Bike TP" or v == "Normal Potato Farm" then movementMode = v end
    end

    function API.SetToggle(t)
        toggleRef = t
    end

    function API.Start()
        if PotatoRunning then return end
        -- wait for a previous run to finish winding down
        local waited = 0
        while threadAlive and waited < 20 do
            task.wait(0.25)
            waited += 0.25
        end
        if threadAlive then return end

        PotatoRunning = true
        bikeFailures = 0
        FarmStartTime = tick()
        SetStatus("Iniciando...")
        pcall(function()
            LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
        end)
        PromptESPStart()
        task.spawn(function()
            threadAlive = true
            local ok, err = pcall(FarmLoop)
            threadAlive = false
            if not ok then
                warn("[Skid Hub] potato farm error: " .. tostring(err))
                notify("Potato farm error: " .. string.sub(tostring(err), 1, 160))
            end
            PotatoRunning = false
            PromptESPStop()
            PRelease()
            pcall(DestroyPlatform)
            if not isFarmRunning then CharLock.surface() end
            RemoveUnderFloor()
            cycleStep = 1
            FarmStartTime = 0
            SetStatus("Detenido")
            if toggleRef and toggleRef.Set then
                pcall(toggleRef.Set, false)
            end
        end)
    end

    function API.Stop()
        if not PotatoRunning then return end
        PotatoRunning = false
        SetStatus("Deteniendo...")
    end

    function API.ApplyTheme(t)
        pcall(function()
            local bg = t.background or Color3.fromRGB(14, 15, 17)
            local text = t.text_color or P.text
            local dim = text:Lerp(bg, 0.25)
            if t.accent then
                pSep.BackgroundColor3 = t.accent
                pStatus.TextColor3 = t.accent
            end
            pHeader.TextColor3 = text
            for _, l in ipairs({ pCycle, pItems, pEarned, pTime, pMode }) do
                l.TextColor3 = dim
            end
        end)
    end

    -- Hard reset used by "Stop all farms".
    function API.Cleanup()
        PotatoRunning = false
        pcall(PromptESPStop)
        pcall(DestroyPlatform)
        if not isFarmRunning then CharLock.surface() end
        RemoveUnderFloor()
        cycleStep = 1
        needRebuy = false
        FarmStartTime = 0
    end

    function API.Destroy()
        PotatoRunning = false
        RemoveUnderFloor()
        PromptESPStop()
        for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
        pcall(DestroyPlatform)
        pcall(function() potatoBlock:Destroy() end)
        pcall(function() statusFrame.Size = UDim2.new(0, 250, 0, PANEL_BASE_H) end)
    end

    return API
end)()

