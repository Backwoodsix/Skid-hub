            if CharLock.pointer ~= false then PointerUI.ClickPrompt(prompt, 0) end
            local hold = 0
            if forceHold and type(forceHold) == "number" and forceHold > 0 then
                hold = forceHold
            elseif prompt.HoldDuration and prompt.HoldDuration > 0 then
                hold = prompt.HoldDuration + 0.2
            end
            if hold > 0 then
                prompt:InputHoldBegin()
                task.wait(hold)
                prompt:InputHoldEnd()
            end
            if fireproximityprompt then
                fireproximityprompt(prompt)
            else
                prompt:InputHoldBegin()
                prompt:InputHoldEnd()
            end
        end)
        if PromptLift.down then pcall(PromptLift.down) end
        return true
    end

    local function forceClick(gui)
        if not gui then return false end
        pcall(function()
            if getconnections then
                for _, name in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up" }) do
                    local sig = gui[name]
                    if sig then
                        for _, c in ipairs(getconnections(sig)) do
                            pcall(function()
                                if c.Fire then c:Fire() end
                                if c.Function then c.Function() end
                            end)
                        end
                    end
                end
            end
        end)
        pcall(function()
            local pos = gui.AbsolutePosition
            local size = gui.AbsoluteSize
            if size.X < 2 or size.Y < 2 then return end
            local inset = GuiService:GetGuiInset()
            local x = pos.X + size.X / 2
            local y = pos.Y + size.Y / 2 + inset.Y
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
            if not isMobile then return end
            VirtualInputManager:SendTouchEvent(x, y, true, game)
            task.wait(0.05)
            VirtualInputManager:SendTouchEvent(x, y, false, game)
        end)
        return true
    end

    -- ------------------------------------------------------------------ death guard
    -- A death stops the farm (so a kill does not turn into a respawn loop). Deliberate respawns
    -- (the 9e9 jump, the Marshmallow farm's setup) are announced through DeathGraceUntil.
    local function EmergencyStopAll(reason)
        if SuppressEmergencyStop or os.clock() < DeathGraceUntil then return end
        if not PotatoRunning then return end
        PotatoRunning = false
        SetStatus("Muerto — farm OFF")
    end

    local function HookDeath(char)
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 8)
        if not hum then return end
        table.insert(connections, hum.Died:Connect(function()
            EmergencyStopAll("Te mataron")
        end))
    end

    if LocalPlayer.Character then
        task.spawn(function() HookDeath(LocalPlayer.Character) end)
    end
    table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(char)
        task.wait(0.2)
        HookDeath(char)
    end))

    local isProtecting = false
    local currentPlatform = nil
    local stayConnection = nil
    local originalY = 0

    local function DestroyPlatform()
        if stayConnection then stayConnection:Disconnect() stayConnection = nil end
        if currentPlatform then currentPlatform:Destroy() currentPlatform = nil end
        isProtecting = false
    end

    local function EnsurePlatform()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        if isProtecting and currentPlatform and currentPlatform.Parent then return true end
        isProtecting = true
        originalY = math.max(hrp.Position.Y, 5)
        currentPlatform = Instance.new("Part")
        currentPlatform.Name = "SafePlatform"
        currentPlatform.Size = Vector3.new(12, 1.5, 12)
        currentPlatform.Anchored = true
        currentPlatform.CanCollide = true
        currentPlatform.Material = Enum.Material.Neon
        currentPlatform.Color = Color3.fromRGB(80, 200, 255)
        currentPlatform.Transparency = 0.25
        currentPlatform.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 4, hrp.Position.Z)
        currentPlatform.Parent = workspace
        stayConnection = RunService.Heartbeat:Connect(function()
            if hrp and hrp.Parent and currentPlatform and currentPlatform.Parent then
                local p = currentPlatform.Position
                hrp.CFrame = CFrame.new(p.X, p.Y + 4.3, p.Z)
            end
        end)
        return true
    end

    local function ForceGoUp()
        if not isProtecting or not currentPlatform then
            isProtecting = false
            return
        end
        SetStatus("Subiendo...")
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local px, pz = currentPlatform.Position.X, currentPlatform.Position.Z
        local targetY = math.max(originalY, 25)
        local upTween = TweenService:Create(currentPlatform,
            TweenInfo.new(2.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { CFrame = CFrame.new(px, targetY - 4.3, pz) })
        upTween:Play()
        upTween.Completed:Wait()
        DestroyPlatform()
        if hrp and hrp.Parent then
            hrp.CFrame = CFrame.new(px, targetY, pz)
        end
    end

    local function SlowTravel(targetPosOrCF, label, standMode)
        local targetPos = typeof(targetPosOrCF) == "CFrame" and targetPosOrCF.Position or targetPosOrCF
        if not targetPos then return false end
        if not EnsurePlatform() then return false end
        SetStatus(label or "Viajando...")

        -- Close stations (the real job is a few studs apart): stay on the platform at street level
        -- and glide straight there instead of dropping and rising again for every station.
        if standMode == nil and CharLock.shortHop and currentPlatform and currentPlatform.Parent then
            local cur = currentPlatform.Position
            local surfaceY = targetPos.Y - 4.3
            local flatDist = Vector2.new(targetPos.X - cur.X, targetPos.Z - cur.Z).Magnitude
            if flatDist <= 45 and math.abs(cur.Y - surfaceY) <= 6 then
                local dest = Vector3.new(targetPos.X, surfaceY, targetPos.Z)
                local speed = (CharLock.walkSpeed or 26) * 1.3
                while PotatoRunning do
                    if not currentPlatform or not currentPlatform.Parent then return false end
                    local pp = currentPlatform.Position
                    local rem = (dest - pp).Magnitude
                    if rem <= 0.6 then break end
                    local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
                    currentPlatform.CFrame = CFrame.new(pp + (dest - pp).Unit * math.min(speed * dt, rem))
                end
                if not PotatoRunning then ForceGoUp() return false end
                currentPlatform.CFrame = CFrame.new(dest)
                task.wait(0.15)
                return true
            end
        end

        if standMode == "depart" then
            local d0 = currentPlatform.Position
            local dirVec = Vector3.new(targetPos.X - d0.X, 0, targetPos.Z - d0.Z)
            if dirVec.Magnitude > 6 then
                dirVec = dirVec.Unit
                local rightVec = Vector3.new(-dirVec.Z, 0, dirVec.X)
                currentPlatform.CFrame = CFrame.new(d0.X + rightVec.X * 6, d0.Y, d0.Z + rightVec.Z * 6)
                task.wait(0.1)
            end
        end

        local vertDown = math.abs(currentPlatform.Position.Y - SafeHeight)
        local downSeconds = math.clamp(vertDown / 14, 1.8, 7)
        local down = TweenService:Create(currentPlatform,
            TweenInfo.new(downSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
            { CFrame = CFrame.new(currentPlatform.Position.X, SafeHeight, currentPlatform.Position.Z) })
        down:Play()
        down.Completed:Wait()

        local endPos = Vector3.new(targetPos.X, SafeHeight, targetPos.Z)
        local detourPos = nil
        if standMode == "arrive" then
            local dStart = currentPlatform.Position
            local dirVec = Vector3.new(targetPos.X - dStart.X, 0, targetPos.Z - dStart.Z)
            if dirVec.Magnitude > 6 then
                dirVec = dirVec.Unit
                local rightVec = Vector3.new(-dirVec.Z, 0, dirVec.X)
                detourPos = Vector3.new(
                    targetPos.X + rightVec.X * 6 - dirVec.X * 2,
                    SafeHeight,
                    targetPos.Z + rightVec.Z * 6 - dirVec.Z * 2
                )
            end
        end

        local function walkTo(dest)
            while PotatoRunning do
                if not currentPlatform or not currentPlatform.Parent then return false end
                if not PotatoRunning then ForceGoUp() return false end
                local current = currentPlatform.Position
                local flat = Vector3.new(current.X, SafeHeight, current.Z)
                local remaining = (dest - flat).Magnitude
                if remaining <= 2 then break end
                local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
                local step = math.min((CharLock.walkSpeed or 26) * dt, remaining)
                currentPlatform.CFrame = CFrame.new(flat + (dest - flat).Unit * step)
            end
            return PotatoRunning
        end

        if detourPos then walkTo(detourPos) end
        walkTo(endPos)
        if not PotatoRunning then ForceGoUp() return false end

        currentPlatform.CFrame = CFrame.new(targetPos.X, SafeHeight, targetPos.Z)
        task.wait(0.2)

        local destY = targetPos.Y - 4.3
        local upSeconds = math.clamp(math.abs(destY - SafeHeight) / 14, 2.6, 8)
        SetStatus("Subiendo...")
        local up = TweenService:Create(currentPlatform,
            TweenInfo.new(upSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { CFrame = CFrame.new(targetPos.X, destY, targetPos.Z) })
        up:Play()
        while up.PlaybackState == Enum.PlaybackState.Playing do
            if not PotatoRunning then up:Cancel() ForceGoUp() return false end
            task.wait(0.1)
        end
        task.wait(0.35)
        return true
    end

    -- ------------------------------------------------------------------ shared character control
    local function potatoAlive()
        return PotatoRunning
    end

    -- The tool in hand is remembered when the character is handed over and put back in hand when it
    -- comes back, because the other farm swaps tools while it has the character.
    local heldMemory, heldNeeded = nil, false
    local function rememberHeld()
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        heldMemory = tool and tool.Name or nil
    end
    local function restoreHeld()
        if not heldMemory then return end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local cur = char:FindFirstChildOfClass("Tool")
        if cur and cur.Name == heldMemory then return end
        local bp = LocalPlayer:FindFirstChild("Backpack")
        local tool = bp and bp:FindFirstChild(heldMemory)
        if tool then
            pcall(function() hum:UnequipTools() end)
            task.wait(0.1)
            pcall(function() hum:EquipTool(tool) end)
            task.wait(0.35)
        end
    end

    -- Takes control of the character (waits while the Marshmallow farm is using it).
    local function PAcquire()
        if CharLock.owner ~= "potato" and CharLock.owner ~= nil then
            SetStatus("Waiting for the other farm...")
        end
        local got = CharLock.acquire("potato", potatoAlive)
        if got and heldNeeded then
            heldNeeded = false
            pcall(restoreHeld)
        end
        return got
    end

    -- Hands the character back. The safe platform pins the character to itself every frame,
    -- so it has to go before the other farm moves anything.
    local function PRelease()
        if CharLock.owner == "potato" then
            pcall(rememberHeld)
            heldNeeded = heldMemory ~= nil
            pcall(DestroyPlatform)
        end
        CharLock.release("potato")
    end

    -- Soft handoff point: only gives the character away if the other farm is waiting for it,
    -- so a single running farm behaves exactly as it did on its own.
    local function PYield()
        if CharLock.owner == "potato" and CharLock.contended() then
            PRelease()
        end
    end

    local function Fail(reason)
        warn("[Skid Hub] " .. reason)
        notify(reason)
        PotatoRunning = false
    end

    -- ------------------------------------------------------------------ Bike TP movement
    local bike = nil
    local bikeFailures = 0

    local function ensureBike()
        if bike and bike.Parent then return true end
        bike = getPlayerBike()
        return bike ~= nil and bike.Parent ~= nil
    end

    -- Request the vehicle at its spawn point and wait for the server to create it.
    local function spawnBike()
        if ensureBike() then return true end
        if not requestBikeSpawn(function() return PotatoRunning end) then return false end
        return ensureBike()
    end

    local function bikeFail(reason)
        bikeFailures += 1
        warn("Potato Bike TP: " .. reason .. " (failure " .. bikeFailures .. "/6)")
        if bikeFailures >= 6 then
            Fail("Potato Bike TP failed 6 times in a row, so the farm was stopped.")
        end
        return false
    end

    -- The floor the character stands on while it is under the map (same size and depth as the
    -- Marshmallow baseplate). It is always placed BEFORE the bike arrives.
    local underFloor = nil
    local function PlaceUnderFloor(x, y, z)
        if not (underFloor and underFloor.Parent) then
            underFloor = Instance.new("Part")
            underFloor.Name = "PotatoUnderFloor"
            underFloor.Size = Vector3.new(25, 12, 25)
            underFloor.Anchored = true
            underFloor.CanCollide = true
            underFloor.Transparency = 1
            underFloor.Parent = Workspace
        end
        underFloor.Position = Vector3.new(x, y - 9, z)
    end
    local function RemoveUnderFloor()
        if underFloor then pcall(function() underFloor:Destroy() end) end
        underFloor = nil
    end

    -- Under the map the player stays low; only while a prompt is pressed it is lifted to the reach
    -- height (learned from the pots) together with its floor, then lowered again.
    local liftedBy = nil
    function PromptLift.up()
        if liftedBy or not (CharLock.stayUnder and isBikeMode()) then return end
        local base = CharLock.standLift or 0
        local delta = math.max(CharLock.reachLift or base, base) - base
        if delta <= 0 then return end
        local _, _, root = getCharacterParts()
        if not root or root.Position.Y > -2 then return end
        local pp = root.Position
        PlaceUnderFloor(pp.X, pp.Y + delta, pp.Z)
        setRootCFrame(CFrame.new(pp.X, pp.Y + delta, pp.Z))
        liftedBy = delta
    end
    function PromptLift.down()
        if not liftedBy then return end
        local delta = liftedBy
        liftedBy = nil
        local _, _, root = getCharacterParts()
        if not root then return end
        local pp = root.Position
        PlaceUnderFloor(pp.X, pp.Y - delta, pp.Z)
        setRootCFrame(CFrame.new(pp.X, pp.Y - delta, pp.Z))
    end

    -- Staged bike hop: drop under the map, cross, then either stay under the map (the default:
    -- the stations are used from 9 studs below, like the stove) or rise at the target.
    local function BikeTravel(pos, label)
        SetStatus(label or "Viajando (bike)...")
        local under = CharLock.stayUnder
        for _ = 1, 3 do
            if not PotatoRunning then return false end

            if not ensureBike() then
                if not (spawnBike() and ensureBike() and bikeMount(bike, 12)) then
                    bikeFail("could not spawn or reach the bike")
                    if not PotatoRunning then return false end
                    task.wait(1)
                    continue
                end
            end

            setBikeAnchored(bike, false)
            local seat = getBikeSeat(bike)
            local _, humanoid = getCharacterParts()
            if not (humanoid and seat and humanoid.SeatPart == seat) then
                if not bikeMount(bike, 10) then
                    bikeFail("could not mount the bike")
                    if not PotatoRunning then return false end
                    task.wait(1)
                    continue
                end
            end

            local standY = pos.Y - 9 + (CharLock.standLift or 0)
            local destination
            if under then
                PlaceUnderFloor(pos.X, standY, pos.Z)
                destination = CFrame.new(pos.X, standY, pos.Z)
            else
                destination = CFrame.new(pos.X, pos.Y + 3, pos.Z)
            end
            if bikeTweenTo(bike, destination) then
                if not under then RemoveUnderFloor() end
                bikeFailures = 0
                task.wait(0.1)
                return true
            end
            if not PotatoRunning then return false end
            bikeFail("bike move did not finish")
            task.wait(1)
        end
        return false
    end

    -- Close stations while already under the map: slide the character and its floor straight there.
    local function UnderGlide(pos)
        local standY = pos.Y - 9 + (CharLock.standLift or 0)
        local speed = (CharLock.walkSpeed or 26) * 1.5
        local dest = Vector3.new(pos.X, standY, pos.Z)
        while PotatoRunning do
            local _, _, root = getCharacterParts()
            if not root then return false end
            local pp = root.Position
            local rem = (dest - pp).Magnitude
            if rem <= 0.6 then break end
            local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
            local np = pp + (dest - pp).Unit * math.min(speed * dt, rem)
            PlaceUnderFloor(np.X, np.Y, np.Z)
            root.CFrame = CFrame.new(np)
            root.AssemblyLinearVelocity = Vector3.zero
        end
        if not PotatoRunning then return false end
        PlaceUnderFloor(dest.X, dest.Y, dest.Z)
        task.wait(0.05)
        return true
    end

    -- Single entry point for every leg of the farm.
    local function Travel(target, label, standMode)
        local pos = typeof(target) == "CFrame" and target.Position or target
        if not pos then return false end
        if isBikeMode() then
            local _, hum0, root = getCharacterParts()
            if root and hum0 and hum0.SeatPart then
                -- seated: never walk or glide, the bike hops instantly (or nothing if already there)
                local flat = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(pos.X + 2, pos.Z)).Magnitude
                if flat < 3 and math.abs(root.Position.Y - (pos.Y + 3)) < 3 then
                    return true
                end
                return BikeTravel(pos, label)
            end
            if root then
                local flat = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(pos.X, pos.Z)).Magnitude
                if flat < 8 and math.abs(root.Position.Y - pos.Y) < 12 then
                    local desiredY = pos.Y - 9 + (CharLock.standLift or 0)
                    if CharLock.stayUnder and CharLock.shortHop and root.Position.Y < -2
                        and math.abs(root.Position.Y - desiredY) > 1.2 then
                        SetStatus(label or "Viajando...")
                        if UnderGlide(pos) then return true end
                        if not PotatoRunning then return false end
                    else
                        return true
                    end
                end
                if CharLock.stayUnder and CharLock.shortHop and root.Position.Y < -2 and flat <= 45 then
                    SetStatus(label or "Viajando...")
                    if UnderGlide(pos) then return true end
                    if not PotatoRunning then return false end
                end
            end
            return BikeTravel(pos, label)
        end
        return SlowTravel(target, label, standMode)
    end

    -- The original teleport method: jump to 9e9 so the character respawns, then place it.
    -- The respawn clears the inventory in some servers, so it is skipped while Marshmallow
    -- ingredients are on hand; the slow platform trip is used instead.
    local function PotatoTPTo(target)
        local dest
        if typeof(target) == "CFrame" then
            dest = target
        elseif typeof(target) == "Vector3" then
            dest = CFrame.new(target)
        else
            return false
        end
        if hasMarshItems() then return false end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        pcall(DestroyPlatform)
        local gotChar, newChar
        local conn
        conn = LocalPlayer.CharacterAdded:Connect(function(ch)
            gotChar = true
            newChar = ch
            if conn then conn:Disconnect() end
        end)
        PotatoDeathGrace(10)
        pcall(function()
            hrp.CFrame = CFrame.new(9e9, 9e9, 9e9)
        end)
        local t0 = tick()
        while not gotChar and tick() - t0 < 6 do task.wait(0.1) end
        if conn then pcall(function() conn:Disconnect() end) end
        task.wait(0.35)
        local root = newChar and newChar:FindFirstChild("HumanoidRootPart")
        if not root then
            newChar = LocalPlayer.Character
            root = newChar and newChar:FindFirstChild("HumanoidRootPart")
        end
        if not root then return false end
        pcall(function()
            root.CFrame = dest
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        task.wait(0.45)
        local hrp2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local quedo = hrp2 and (hrp2.Position - dest.Position).Magnitude or 999
        return quedo < 40
    end

    -- Long trips (the shop): Bike TP rides, Normal jumps first and falls back to the platform.
    local function FarTravel(pos, label)
        if isBikeMode() then
            return Travel(pos, label)
        end
        if PotatoTPTo(pos) then return true end
        return SlowTravel(pos, label)
    end

    local BuyPotatoRemote
    do
        local NPC_ID = 21
        local ITEMS = {
            { name = "Flour",  index = 1 },
            { name = "Potato", index = 2 },
        }

        local cachedRE
        local function getRE()
            if cachedRE and cachedRE.Parent then return cachedRE end
            local ok, re = pcall(function()
                local folder = ReplicatedStorage:WaitForChild("RemoteEvents", 5)
                return folder and folder:WaitForChild("ReliableRemoteEvent", 5)
            end)
            cachedRE = (ok and re) or nil
            return cachedRE
        end

        local RATE = 0.07
        local MAX_TOKENS = 6
        local JITTER = 0.45
        local tokens, last = MAX_TOKENS, os.clock()

        local function throttle()
            local now = os.clock()
            local dt = now - last
            if dt > 0 and tokens < MAX_TOKENS then
                tokens = math.min(MAX_TOKENS, tokens + dt / RATE)
            end
            last = now
            while tokens < 1 do
                local w = (1 - tokens) * RATE
                task.wait(w * (1 - JITTER + math.random() * JITTER * 2))
                local now2 = os.clock()
                local dt2 = now2 - last
                if dt2 > 0 and tokens < MAX_TOKENS then
                    tokens = math.min(MAX_TOKENS, tokens + dt2 / RATE)
                end
                last = now2
            end
            tokens -= 1
        end

        local function countItemExact(name)
            return CountExactTool(name)
        end

        local function fireBuy(re, index)
            if not (typeof(re) == "Instance" and re.Parent) then return end
            throttle()
            local v1 = buffer.create(3)
            buffer.writeu8(v1, 0, 24)
            buffer.writeu8(v1, 1, NPC_ID)
            buffer.writeu8(v1, 2, index)
            pcall(function() re:FireServer(v1) end)
        end

        local function buyItemCount(re, name, index, cantidad)
            if countItemExact(name) >= cantidad then return true end
            local rondas = 0
            while countItemExact(name) < cantidad and rondas < 5 do
                rondas += 1
                local falta = cantidad - countItemExact(name)
                for _ = 1, falta do
                    if not PotatoRunning then return false end
                    fireBuy(re, index)
                    task.wait(0.07 + math.random() * 0.03)
                end
                local t0 = os.clock()
                while os.clock() - t0 < 1.8 do
                    if countItemExact(name) >= cantidad then break end
                    task.wait(0.05)
                end
            end
            return countItemExact(name) >= cantidad
        end

        local function minMax(cantidad)
            for _, it in ipairs(ITEMS) do
                if countItemExact(it.name) < cantidad then return false end
            end
            return true
        end

        BuyPotatoRemote = function(cantidad)
            cantidad = math.clamp(math.floor(cantidad or 1), 1, 12)
            local re = getRE()
            if not re then return false end

            local pasadas = 0
            while not minMax(cantidad) and pasadas < 6 do
                pasadas += 1
                for _, it in ipairs(ITEMS) do
                    if not PotatoRunning then return false end
                    if countItemExact(it.name) < cantidad then
                        buyItemCount(re, it.name, it.index, cantidad)
                    end
                end
                task.wait(0.4)
            end
            return minMax(cantidad)
        end
    end

    local function AutoBuyIngredients(amount)
        if not PotatoRunning then return false end
        amount = math.clamp(math.floor(amount or farmAmount or 1), 1, 12)

        if CountExactTool("Flour") >= amount and CountPotato() >= amount then
            SetStatus("Materiales listos (remote)")
            return true
        end

        local remoteBuy = BuyPotatoRemote
        if not remoteBuy then
            SetStatus("Fallo compra remota — sin remote")
            return false
        end

        for attempt = 1, 6 do
            if not PotatoRunning then return false end
            SetStatus("Comprando papas (remote)... (" .. attempt .. "/6)")
            if remoteBuy(amount) then
                SetStatus("Materiales listos (remote)")
                return true
            end
            task.wait(1.2)
        end

        SetStatus("Fallo compra remota — reintentando...")
        return false
    end

    local function EquipToolExact(name)
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        for _ = 1, 5 do
            local tool = GetTool(name)
            if tool then
                pcall(function() hum:UnequipTools() end)
                task.wait(0.12)
                pcall(function() hum:EquipTool(tool) end)
                task.wait(0.4)
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(tool.Name) then
                    return true
                end
            else
                task.wait(0.25)
            end
        end
        return false
    end

