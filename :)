        -- the ReliableRemoteEvent, which drops the socket with the generic
        -- "Server error occurred (Error Code: 267)" kick (no Lua message,
        -- no Hyphon handshake log). Floor BuyDelay at 0.3s regardless of
        -- what the user set it to.
        local _lastBuyFireAt = 0
        local BUY_MIN_GAP    = 0.3  -- hard floor between buffer fires
        local function safeBuyFire(buf)
            local now = tick()
            local gap = now - _lastBuyFireAt
            if gap < BUY_MIN_GAP then
                task.wait(BUY_MIN_GAP - gap)
            end
            _lastBuyFireAt = tick()
            remote:FireServer(buf)
        end

        local function buyItem(itemId, wantQty)
            local name  = ITEM_IDS[itemId]
            local tries = neededCount(itemId, wantQty) + 2
            local bought = 0
            while neededCount(itemId, wantQty) > 0 and bought < tries do
                if mfStopped() then return false end
                local before = stableCount(name)
                safeBuyFire(makeBuyBuf(itemId))
                bought = bought + 1
                local deadline = tick() + 3.5
                while stableCount(name) <= before and tick() < deadline do
                    if mfStopped() then return false end
                    task.wait(0.1)
                end
                task.wait(math.max(farm.BuyDelay or 0.4, BUY_MIN_GAP))
            end
            task.wait(0.4)
            return neededCount(itemId, wantQty) <= 0
        end

