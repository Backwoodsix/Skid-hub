-- On-screen pointer: a visible cursor that glides to a prompt's button and presses it with a real
-- mouse + touch click, so prompts work the same way a finger would press them.
local PointerUI = {}
do
    local pointerGui = Instance.new("ScreenGui")
    pointerGui.Name = "SkidPointerUI"
    pointerGui.ResetOnSpawn = false
    pointerGui.IgnoreGuiInset = true
    pointerGui.DisplayOrder = 1000000
    pointerGui.Parent = parentGui

    local root = Instance.new("Frame")
    root.Name = "Pointer"
    root.BackgroundTransparency = 1
    root.Size = UDim2.fromOffset(0, 0)
    root.Position = UDim2.new(0.5, 0, 0.6, 0)
    root.Active = false
    root.ZIndex = 1000
    root.Parent = pointerGui

    local arrow = Instance.new("ImageLabel")
    arrow.BackgroundTransparency = 1
    arrow.Size = UDim2.fromOffset(34, 34)
    arrow.Position = UDim2.fromOffset(0, 0)
    arrow.Image = "rbxasset://textures/Cursors/KeyboardMouse/ArrowCursor.png"
    arrow.Active = false
    arrow.ZIndex = 1001
    arrow.Parent = root

    local function toScreen(vp)
        local inset = game:GetService("GuiService"):GetGuiInset()
        return Vector2.new(vp.X, vp.Y + inset.Y)
    end

    function PointerUI.SetVisible(v)
        pointerGui.Enabled = v and true or false
    end

    function PointerUI.Destroy()
        pcall(function() pointerGui:Destroy() end)
    end

    local function glideTo(x, y, seconds)
        local tween = game:GetService("TweenService"):Create(root,
            TweenInfo.new(seconds or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Position = UDim2.fromOffset(x, y) })
        tween:Play()
        tween.Completed:Wait()
    end

    local function realClick(x, y, holdFor)
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
            VirtualInputManager:SendTouchEvent(1, 0, x, y)
        end)
        task.wait(math.max(0.03, holdFor or 0))
        pcall(function()
            VirtualInputManager:SendTouchEvent(1, 2, x, y)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
        end)
    end

    -- Where the prompt's button is on screen (the prompt's own spot, shifted by its button if found).
    local function promptPoint(prompt)
        local adornee = prompt.Parent
        local worldPos
        if adornee and adornee:IsA("BasePart") then
            worldPos = adornee.Position
        elseif adornee and adornee:IsA("Attachment") then
            worldPos = adornee.WorldPosition
        elseif adornee and adornee:IsA("Model") then
            worldPos = adornee:GetPivot().Position
        end
        if not worldPos then return nil end
        local cam = Workspace.CurrentCamera
        if not cam then return nil end

        local offsetPx = Vector2.new(0, 0)
        pcall(function() offsetPx = offsetPx + prompt.UIOffset end)
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            local scope = playerGui:FindFirstChild("ProximityPrompts") or playerGui
            for _, bb in ipairs(scope:GetDescendants()) do
                if bb:IsA("BillboardGui") and bb.Adornee == adornee then
                    for _, btn in ipairs(bb:GetDescendants()) do
                        if btn:IsA("GuiButton") and btn.AbsoluteSize.X > 4 then
                            offsetPx = offsetPx + (btn.AbsolutePosition + btn.AbsoluteSize / 2 - bb.AbsoluteSize / 2)
                            break
                        end
                    end
                    break
                end
            end
        end
        local vp, onScreen = cam:WorldToViewportPoint(worldPos)
        return worldPos, vp, onScreen and vp.Z > 0, offsetPx
    end

    -- Moves the pointer onto the prompt and clicks. If the prompt is off screen the camera is
    -- turned to face it for the click and handed back afterwards. Returns true if a click was made.
    function PointerUI.ClickPrompt(prompt, holdFor)
        if not (prompt and prompt.Parent) then return false end
        local cam = Workspace.CurrentCamera
        if not cam then return false end
        local worldPos, vp, visible, offsetPx = promptPoint(prompt)
        if not worldPos then return false end

        local restore
        if not visible then
            local prevType = cam.CameraType
            cam.CameraType = Enum.CameraType.Scriptable
            cam.CFrame = CFrame.lookAt(worldPos + Vector3.new(0, 6, 12), worldPos)
            restore = function() pcall(function() cam.CameraType = prevType end) end
            task.wait(0.1)
            worldPos, vp, visible, offsetPx = promptPoint(prompt)
            if not worldPos then
                restore()
                return false
            end
        end

        local point = toScreen(vp) + offsetPx
        glideTo(point.X, point.Y, 0.07)
        realClick(point.X, point.Y, holdFor)
        if restore then restore() end
        return true
    end
end

-- Universal prompt activation. Every way a prompt can be triggered is tried in turn, stopping as
-- soon as the caller's check says it worked:
--   1 fireproximityprompt   (instant, any device)
--   2 the prompt's own InputHoldBegin/End   (what the on-screen button does)
--   3 a simulated E key     (keyboard devices)
--   4 a tap on the prompt's button / on its spot on screen   (touch devices)
-- With "Instant prompts" on, the hold time is dropped to 0 so nothing waits for a hold.
local function tapPromptButton(prompt)
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local adornee = prompt.Parent
        if not (playerGui and adornee) then return end
        if type(getconnections) == "function" then
            for _, obj in ipairs(playerGui:GetDescendants()) do
                if obj:IsA("GuiButton") then
                    local bb = obj:FindFirstAncestorWhichIsA("BillboardGui")
                    if bb and bb.Adornee == adornee then
                        for _, signal in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up", "TouchTap" }) do
                            pcall(function()
                                for _, c in ipairs(getconnections(obj[signal])) do
                                    pcall(function() if c.Fire then c:Fire() end end)
                                end
                            end)
                        end
                    end
                end
            end
        end
        local worldPos
        if adornee:IsA("BasePart") then
            worldPos = adornee.Position
        elseif adornee:IsA("Attachment") then
            worldPos = adornee.WorldPosition
        elseif adornee:IsA("Model") then
            worldPos = adornee:GetPivot().Position
        end
        local cam = Workspace.CurrentCamera
        if worldPos and cam then
            local vp, onScreen = cam:WorldToViewportPoint(worldPos)
            if onScreen and vp.Z > 0 then
                local inset = game:GetService("GuiService"):GetGuiInset()
                VirtualInputManager:SendMouseButtonEvent(vp.X, vp.Y + inset.Y, 0, true, game, 1)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(vp.X, vp.Y + inset.Y, 0, false, game, 1)
            end
        end
    end)
end

local function activatePrompt(prompt, opts)
    opts = opts or {}
    if not (prompt and prompt.Parent) then return false end
    local instant = CharLock.instantPrompts ~= false
    local hold = 0
    if not instant then
        local okHold, hd = pcall(function() return prompt.HoldDuration end)
        hold = okHold and hd or 0
    end
    pcall(function()
        prompt.Enabled = true
        prompt.MaxActivationDistance = 100
        prompt.RequiresLineOfSight = false
        if instant then prompt.HoldDuration = 0 end
    end)

    local function worked()
        if not opts.done then return false end
        local ok, result = pcall(opts.done)
        return ok and result == true
    end
    -- Gives the game a moment to react and reports whether the caller's check passed.
    local function settle()
        if not opts.done then
            task.wait(0.1)
            return false
        end
        local t0 = os.clock()
        repeat
            task.wait(0.05)
            if worked() then return true end
        until os.clock() - t0 > 0.3
        return false
    end

    if CharLock.pointer ~= false then
        local clicked = false
        pcall(function() clicked = PointerUI.ClickPrompt(prompt, hold) end)
        if clicked and settle() then return true end
    end

    if type(fireproximityprompt) == "function" then
        if hold > 0 then
            pcall(function() prompt:InputHoldBegin() end)
            task.wait(hold + 0.15)
            pcall(function() prompt:InputHoldEnd() end)
        end
        pcall(fireproximityprompt, prompt)
        if settle() then return true end
    end

    pcall(function() prompt:InputHoldBegin() end)
    if hold > 0 then task.wait(hold + 0.15) end
    pcall(function() prompt:InputHoldEnd() end)
    if settle() then return true end

    if opts.key then opts.key() else pressKeyE() end
    if settle() then return true end

    tapPromptButton(prompt)
    settle()
    return worked()
end


