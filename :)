    local function FindPromptNear(pos, radius)
        radius = radius or 8
        local best, bestDist
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local part = obj.Parent
                local p
                if part and part:IsA("BasePart") then
                    p = part.Position
                elseif part and part:IsA("Attachment") then
                    p = part.WorldPosition
                elseif part then
                    local bp = part:FindFirstChildWhichIsA("BasePart")
                        or (part.Parent and part.Parent:IsA("BasePart") and part.Parent)
                    if bp then p = bp.Position end
                end
                if p then
                    local d = (p - pos).Magnitude
                    if d <= radius and (not bestDist or d < bestDist) then
                        best, bestDist = obj, d
                    end
                end
            end
        end
        return best
    end

    local promptForce = { on = false, list = {}, refreshAt = 0, job = nil }

    local function CollectPrompts()
        local out = {}
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                local parent = d.Parent
                local p
                if parent and parent:IsA("BasePart") then
                    p = parent.Position
                elseif parent and parent:IsA("Attachment") then
                    p = parent.WorldPosition
                end
                if p then
                    out[#out + 1] = { prompt = d, pos = p }
                end
            end
        end
        return out
    end

    local function ForceNearbyPrompts(radius)
        radius = radius or 12
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local pos = hrp.Position

        local now = tick()
        if now >= promptForce.refreshAt or #promptForce.list == 0 then
            promptForce.refreshAt = now + 2
            promptForce.list = CollectPrompts()
        end

        local mejor, mejorDist
        for _, e in ipairs(promptForce.list) do
            if e.prompt and e.prompt.Parent then
                local d = (e.pos - pos).Magnitude
                if d <= radius and (not mejorDist or d < mejorDist) then
                    mejor, mejorDist = e, d
                end
            end
        end

        if mejor then
            pcall(function()
                mejor.prompt.Enabled = true
                mejor.prompt.RequiresLineOfSight = false
                mejor.prompt.HoldDuration = 0
                if mejor.prompt.MaxActivationDistance < 60 then
                    mejor.prompt.MaxActivationDistance = 60
                end
            end)
        end
    end

