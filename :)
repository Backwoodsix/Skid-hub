local function ApplyThemeColors(t)
    for _, key in ipairs(THEME_KEYS) do
        if t[key] then
            pcall(function() Library:RefreshTheme(key, t[key]) end)
            currentTheme[key] = t[key]
        end
    end
    pcall(function() Window.Items.Glow.ImageColor3 = currentTheme.glow end)
    -- Shared farm status panel + batch notification
    pcall(function()
        statusFrame.BackgroundColor3 = currentTheme.background
        notifyFrame.BackgroundColor3 = currentTheme.background
        statusStroke.Color = currentTheme.accent
        leftStrip.BackgroundColor3 = currentTheme.accent
        notiTitle.TextColor3 = currentTheme.accent
        goalStatusLabel.TextColor3 = currentTheme.accent
        statusHeader.TextColor3 = currentTheme.text_color
    end)
    PotatoAPI.ApplyTheme(currentTheme)
end

local function ApplyThemePreset(name, remember)
    local preset = ThemePresets[name]
    if not preset then return end
    ApplyThemeColors(preset)
    if remember and type(writefile) == "function" then
        pcall(writefile, THEME_FILE, name)
    end
end

